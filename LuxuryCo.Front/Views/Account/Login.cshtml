@model LuxuryCo.Front.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión — LuxuryCo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            height: 100%; width: 100%;
            background: var(--black);
            color: var(--text);
            font-family: var(--font-ui);
            overflow: hidden;
        }

        .login-wrapper {
            display: flex;
            height: 100vh;
            width: 100vw;
        }

        /* ── PANEL IZQUIERDO — Imagen ─────────────────── */
        .login-img-panel {
            flex: 1;
            position: relative;
            overflow: hidden;
        }
        .login-img-panel img {
            width: 100%; height: 100%;
            object-fit: cover;
            object-position: center;
            display: block;
        }
        .login-img-overlay {
            position: absolute; inset: 0;
            background: linear-gradient(
                to bottom,
                rgba(0,0,0,0.1) 0%,
                rgba(0,0,0,0.05) 40%,
                rgba(0,0,0,0.65) 100%
            );
        }
        /* Botón volver */
        .btn-login-back {
            position: absolute; top: 1.8rem; left: 1.8rem; z-index: 20;
            width: 42px; height: 42px;
            background: rgba(0,0,0,0.35);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(212,175,55,0.3);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            color: #fff; text-decoration: none; font-size: 0.95rem;
            transition: all 0.3s ease;
        }
        .btn-login-back:hover {
            background: rgba(212,175,55,0.15);
            border-color: var(--gold);
            color: var(--gold);
        }
        /* Badge de marca en la imagen */
        .img-brand-badge {
            position: absolute; bottom: 2.8rem; left: 2.8rem; z-index: 20;
        }
        .img-brand-badge .badge-eyebrow {
            font-size: 0.58rem; letter-spacing: 5px; text-transform: uppercase;
            color: rgba(255,255,255,0.55); margin-bottom: 6px; display: block;
        }
        .img-brand-badge .badge-title {
            font-family: var(--font-display);
            font-size: 2rem; color: #fff; letter-spacing: 4px; font-weight: 300;
            line-height: 1; display: block;
        }
        .img-brand-badge .badge-location {
            font-size: 0.62rem; letter-spacing: 3px; color: var(--gold);
            text-transform: uppercase; margin-top: 6px; display: block;
        }

        /* ── PANEL DERECHO — Formulario dark ──────────── */
        .login-form-panel {
            width: 500px;
            min-width: 440px;
            flex-shrink: 0;
            background: var(--black-soft);
            border-left: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem 2.8rem;
            overflow-y: auto;
        }
        .login-form-inner {
            width: 100%;
            max-width: 380px;
        }

        /* Encabezado del formulario */
        .lf-logo {
            font-family: var(--font-display);
            font-size: 0.9rem; letter-spacing: 6px;
            text-transform: uppercase; color: var(--gold);
            margin-bottom: 2rem; display: block;
        }
        .lf-title {
            font-family: var(--font-display);
            font-size: 2rem; font-weight: 400;
            letter-spacing: 2px; color: var(--text);
            margin-bottom: 0.4rem; line-height: 1.2;
        }
        .lf-subtitle {
            font-size: 0.8rem; color: var(--text-muted);
            margin-bottom: 2.5rem; letter-spacing: 0.3px;
        }
        .lf-subtitle a {
            color: var(--gold); text-decoration: none;
            border-bottom: 1px solid rgba(212,175,55,0.4);
            transition: border-color 0.2s;
        }
        .lf-subtitle a:hover { border-color: var(--gold); }

        /* Input con ojo */
        .input-icon-wrap { position: relative; }
        .input-icon-wrap .auth-input { padding-right: 46px; }
        .btn-eye {
            position: absolute; right: 13px; top: 50%;
            transform: translateY(-50%);
            background: none; border: none; padding: 4px;
            color: var(--text-muted); cursor: pointer;
            transition: color 0.2s;
        }
        .btn-eye:hover { color: var(--gold); }

        /* Fila Remember / Forgot */
        .lf-options {
            display: flex; align-items: center;
            justify-content: space-between;
            margin: 1.1rem 0 1.6rem;
        }
        .lf-remember {
            display: flex; align-items: center; gap: 8px;
            font-size: 0.78rem; color: var(--text-muted); cursor: pointer;
        }
        .lf-remember input[type="checkbox"] {
            width: 14px; height: 14px; accent-color: var(--gold); cursor: pointer;
        }
        .btn-lf-forgot {
            background: none; border: none; padding: 0;
            font-size: 0.78rem; color: var(--text-muted);
            font-family: var(--font-ui); cursor: pointer;
            transition: color 0.2s;
        }
        .btn-lf-forgot:hover { color: var(--gold); }

        /* Divisor */
        .lf-divider {
            display: flex; align-items: center; gap: 12px;
            margin: 1.8rem 0; font-size: 0.72rem; color: var(--border-light);
            letter-spacing: 2px; text-transform: uppercase;
        }
        .lf-divider::before, .lf-divider::after {
            content: ''; flex: 1; height: 1px; background: var(--border);
        }

        /* Pie del formulario */
        .lf-footer-note {
            font-size: 0.72rem; color: var(--text-muted);
            text-align: center; line-height: 1.7;
        }
        .lf-footer-note a {
            color: var(--text-secondary); text-decoration: underline;
            text-underline-offset: 2px;
        }
        .lf-footer-note a:hover { color: var(--gold); }

        /* Vista olvidé contraseña */
        .forgot-panel { display: none; }
        .forgot-panel .lf-subtitle {
            font-size: 0.82rem; color: var(--text-muted);
            line-height: 1.7; margin-bottom: 1.5rem;
        }
        .btn-back-to-login {
            background: none; border: none; padding: 0;
            font-size: 0.78rem; color: var(--text-muted);
            font-family: var(--font-ui); cursor: pointer;
            display: inline-flex; align-items: center; gap: 7px;
            margin-top: 1rem; transition: color 0.2s;
        }
        .btn-back-to-login:hover { color: var(--gold); }

        /* ── Responsive ───────────────────────────────── */
        @@media (max-width: 820px) {
            html, body { overflow: auto; }
            .login-wrapper { flex-direction: column; height: auto; min-height: 100vh; }
            .login-img-panel { height: 260px; flex: none; }
            .login-form-panel { width: 100%; min-width: 0; padding: 2.5rem 1.5rem; }
        }
    </style>
</head>
<body>
<div class="login-wrapper">

    <!-- ─── PANEL IZQUIERDO: Imagen ─── -->
    <div class="login-img-panel">
        <a href="/" class="btn-login-back" title="Volver al inicio">
            <i class="fas fa-arrow-left"></i>
        </a>
        <img src="~/images/login_boutique.jpg" alt="Boutique LuxuryCo Provenza Medellín" />
        <div class="login-img-overlay"></div>
        <div class="img-brand-badge">
            <span class="badge-eyebrow">Bienvenido a</span>
            <span class="badge-title">LUXURYCO</span>
            <span class="badge-location">Provenza · Medellín · Colombia</span>
        </div>
    </div>

    <!-- ─── PANEL DERECHO: Formulario dark ─── -->
    <div class="login-form-panel">
        <div class="login-form-inner">

            <span class="lf-logo">LuxuryCo</span>

            <!-- ── VISTA: Iniciar Sesión ── -->
            <div id="loginView">
                <h1 class="lf-title">Bienvenido de vuelta</h1>
                <p class="lf-subtitle">
                    ¿No tienes una cuenta?
                    <a asp-action="Register" asp-controller="Account">Regístrate aquí</a>
                </p>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="auth-alert-success mb-3">
                        <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="auth-alert-error mb-3">
                        <i class="fas fa-exclamation-triangle me-1"></i> @TempData["ErrorMessage"]
                    </div>
                }

                <form method="post" asp-action="Login" asp-controller="Account">
                    <div asp-validation-summary="All" class="auth-alert-error mb-3"
                         style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                    <div class="mb-4">
                        <label class="auth-label">Correo Electrónico</label>
                        <input name="Email" type="email" class="auth-input"
                               placeholder="tu@correo.com" required autocomplete="email" />
                    </div>

                    <div class="mb-1">
                        <label class="auth-label">Contraseña</label>
                        <div class="input-icon-wrap">
                            <input name="Password" id="passwordInput" type="password"
                                   class="auth-input" placeholder="••••••••"
                                   required autocomplete="current-password" />
                            <button type="button" class="btn-eye" onclick="togglePassword()" title="Mostrar/ocultar">
                                <i class="far fa-eye" id="eyeIcon"></i>
                            </button>
                        </div>
                    </div>

                    <div class="lf-options">
                        <label class="lf-remember">
                            <input type="checkbox" name="RememberMe" />
                            Recordarme
                        </label>
                        <button type="button" class="btn-lf-forgot" onclick="toggleViews('forgot')">
                            ¿Olvidaste tu contraseña?
                        </button>
                    </div>

                    <button type="submit" class="btn-auth-primary">
                        Iniciar Sesión
                    </button>

                    <div class="lf-divider">o</div>

                    <p class="lf-footer-note">
                        Al iniciar sesión aceptas nuestros
                        <a href="#">Términos de Servicio</a> y la
                        <a href="#">Política de Privacidad</a> de LuxuryCo.
                    </p>
                </form>
            </div>

            <!-- ── VISTA: Olvidé mi contraseña ── -->
            <div id="forgotPasswordView" class="forgot-panel">
                <h1 class="lf-title">Restablecer contraseña</h1>
                <p class="lf-subtitle">
                    Ingresa tu correo y te enviaremos un enlace para crear una nueva contraseña.
                    Revisa también tu carpeta de spam.
                </p>

                <form method="post" asp-action="ForgotPassword" asp-controller="Account">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <label class="auth-label">Correo Electrónico</label>
                        <input name="Email" type="email" class="auth-input"
                               placeholder="tu@correo.com" required />
                    </div>
                    <button type="submit" class="btn-auth-primary">
                        <i class="fas fa-paper-plane me-2"></i> Enviar enlace
                    </button>
                </form>

                <button type="button" class="btn-back-to-login" onclick="toggleViews('login')">
                    <i class="fas fa-arrow-left" style="font-size:0.7rem;"></i>
                    Volver al inicio de sesión
                </button>
            </div>

        </div>
    </div>

</div>

<script>
    function toggleViews(view) {
        document.getElementById('loginView').style.display          = view === 'login'  ? 'block' : 'none';
        document.getElementById('forgotPasswordView').style.display  = view === 'forgot' ? 'block' : 'none';
    }
    function togglePassword() {
        const input = document.getElementById('passwordInput');
        const icon  = document.getElementById('eyeIcon');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        }
    }
</script>
</body>
</html>
