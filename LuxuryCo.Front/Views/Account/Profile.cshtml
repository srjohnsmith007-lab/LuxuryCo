@model LuxuryCo.Front.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Mi Perfil";
}

<style>
    .profile-card {
        background: var(--black-card); border: 1px solid var(--border);
        border-top: 2px solid var(--gold); padding: 3rem;
    }
    .profile-avatar {
        width: 150px; height: 150px; object-fit: cover;
        border: 2px solid var(--gold); border-radius: 50%;
    }
    .profile-avatar-edit {
        bottom: 0; right: 0; width: 40px; height: 40px; padding: 0;
        background: var(--gold); color: var(--black); border: none;
        border-radius: 50%; cursor: pointer; display: flex;
        align-items: center; justify-content: center; font-size: 0.85rem;
    }
    .profile-avatar-edit:hover { background: var(--gold-light); }
    .profile-field { border-bottom: 1px solid var(--border); padding-bottom: 12px; margin-bottom: 1rem; }
    .profile-field-label { font-size: 0.75rem; color: var(--gold); text-transform: uppercase; letter-spacing: 1px; }
    .profile-field-value { color: var(--text); margin-top: 4px; }
</style>

<div class="container py-5" style="min-height: calc(100vh - 80px); background: var(--black);">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="profile-card mx-auto" data-reveal="up">
                <h2 class="text-center mb-4" style="font-family: var(--font-display); color: var(--text);">Mi Perfil</h2>
                
                <div class="text-center mb-4">
                    <div class="position-relative d-inline-block">
                        <img id="profileImage"
                             src="@(!string.IsNullOrEmpty(Model?.FotoPerfilUrl) ? Model.FotoPerfilUrl : "~/images/default-avatar.png")"
                             alt="Foto de Perfil"
                             class="profile-avatar"
                             onerror="this.onerror=null; this.src='https://cdn-icons-png.flaticon.com/512/1144/1144760.png';" />
                        <button type="button" class="profile-avatar-edit position-absolute"
                                onclick="document.getElementById('fileInput').click();"
                                aria-label="Editar foto de perfil">
                            <i class="fas fa-camera"></i>
                        </button>
                    </div>
                </div>

                <form id="uploadForm" enctype="multipart/form-data" class="d-none">
                    <input type="file" id="fileInput" name="file" accept="image/*" onchange="uploadPhoto()" />
                </form>

                <div class="mt-5">
                    <div class="profile-field">
                        <span class="profile-field-label">NOMBRE COMPLETO</span>
                        <h5 class="profile-field-value">@(Model?.Nombre ?? "Usuario") @(Model?.Apellido ?? "")</h5>
                    </div>
                    <div class="profile-field mb-4">
                        <span class="profile-field-label">CORREO ELECTRÓNICO</span>
                        <h5 class="profile-field-value">@(Model?.Email ?? "correo@ejemplo.com")</h5>
                    </div>
                </div>

                <div class="text-center mt-5">
                    <a asp-controller="Account" asp-action="Logout"
                       class="btn btn-outline-light w-100 py-2 d-flex align-items-center justify-content-center gap-2"
                       style="border-radius: 0; text-transform: uppercase; border-color: var(--border-light);"
                       onmouseover="this.style.borderColor='var(--gold)';this.style.color='var(--gold)'"
                       onmouseout="this.style.borderColor='var(--border-light)';this.style.color=''">
                        CERRAR SESIÓN
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function uploadPhoto() {
        const formData = new FormData();
        const fileInput = document.getElementById('fileInput');
        
        if (fileInput.files.length > 0) {
            formData.append("file", fileInput.files[0]);

            fetch('/Account/UploadProfilePicture', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('profileImage').src = data.url + "?t=" + new Date().getTime();
                    // Toast instead of alert
                    const toast = document.createElement('div');
                    toast.className = 'toast-luxury show toast-success';
                    toast.innerHTML = '<i class="fas fa-check-circle" style="color:var(--gold);margin-right:10px;"></i> Foto de perfil actualizada correctamente.';
                    document.body.appendChild(toast);
                    setTimeout(() => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 400); }, 3000);
                } else {
                    alert("Error al subir la foto: " + data.message);
                }
            })
            .catch(error => {
                console.error("Error:", error);
                alert("Error crítico al subir la imagen.");
            });
        }
    }
</script>
}
