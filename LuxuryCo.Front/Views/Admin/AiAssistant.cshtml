@{
    ViewData["Title"] = "Asistente IA · Admin LuxuryCo";
}

<style>
    .ai-wrapper {
        position: relative;
        min-height: 100vh;
        color: #f0f0f0;
        font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
        background: #050508;
        overflow-x: hidden;
    }

    /* ── AI Aurora Background ── */
    .ai-bg-canvas {
        position: fixed;
        inset: 0;
        width: 100%; height: 100%;
        z-index: 0;
        pointer-events: none;
    }
    .ai-aurora {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        overflow: hidden;
    }
    .ai-aurora::before {
        content: '';
        position: absolute;
        width: 900px; height: 600px;
        top: -200px; left: -150px;
        background: radial-gradient(ellipse, rgba(212,175,55,0.12) 0%, rgba(139,105,20,0.06) 40%, transparent 70%);
        animation: auroraShift1 12s ease-in-out infinite alternate;
        filter: blur(60px);
    }
    .ai-aurora::after {
        content: '';
        position: absolute;
        width: 700px; height: 500px;
        bottom: -100px; right: -100px;
        background: radial-gradient(ellipse, rgba(100,60,255,0.10) 0%, rgba(60,180,255,0.06) 50%, transparent 70%);
        animation: auroraShift2 15s ease-in-out infinite alternate;
        filter: blur(70px);
    }
    .ai-aurora-mid {
        position: fixed;
        width: 500px; height: 400px;
        top: 30%; left: 40%;
        background: radial-gradient(ellipse, rgba(0,200,150,0.06) 0%, transparent 70%);
        animation: auroraShift3 18s ease-in-out infinite alternate;
        filter: blur(80px);
        z-index: 0;
        pointer-events: none;
    }
    @@keyframes auroraShift1 {
        from { transform: translate(0,0) scale(1); opacity: 0.8; }
        to   { transform: translate(120px, 80px) scale(1.2); opacity: 1; }
    }
    @@keyframes auroraShift2 {
        from { transform: translate(0,0) scale(1.1); opacity: 0.6; }
        to   { transform: translate(-80px, -60px) scale(0.9); opacity: 1; }
    }
    @@keyframes auroraShift3 {
        from { transform: translate(0,0); opacity: 0.4; }
        to   { transform: translate(-50px, 80px); opacity: 0.8; }
    }

    /* ── Dot grid overlay ── */
    .ai-dot-grid {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image: radial-gradient(circle, rgba(255,255,255,0.045) 1px, transparent 1px);
        background-size: 32px 32px;
        mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 40%, transparent 100%);
    }

    /* All inner content must sit above bg layers */
    .ai-header, .ai-body, .admin-nav-luxury {
        position: relative;
        z-index: 1;
    }
    .ai-header {
        padding: 1.75rem 2rem 0;
        border-bottom: 1px solid rgba(255,255,255,0.07);
    }
    .ai-header h1 {
        font-family: 'Playfair Display', serif;
        font-size: 1.6rem;
        font-weight: 700;
        color: #f0f0f0;
        margin: 0;
        letter-spacing: 1px;
    }
    .ai-header p { color: #888; font-size: 0.83rem; margin: 0.25rem 0 0; }

    .ai-body {
        display: grid;
        grid-template-columns: 1fr 280px;
        gap: 1.25rem;
        padding: 1.5rem 2rem;
        height: calc(100vh - 160px);
    }
    @@media (max-width: 900px) { .ai-body { grid-template-columns: 1fr; height: auto; } }

    /* Chat card */
    .ai-chat-card {
        background: #141418;
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        height: 100%;
    }
    .ai-chat-header {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid rgba(255,255,255,0.07);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
    }
    .ai-chat-header-left {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .ai-avatar {
        width: 38px; height: 38px;
        border-radius: 50%;
        background: linear-gradient(135deg, #d4af37, #8b6914);
        display: flex; align-items: center; justify-content: center;
        font-size: 1rem; color: #000; flex-shrink: 0;
    }
    .ai-chat-name { font-weight: 600; font-size: 0.92rem; color: #f0f0f0; margin: 0; }
    .ai-chat-status { font-size: 0.72rem; color: #34d399; display: flex; align-items: center; gap: 5px; }
    .ai-chat-status::before { content:''; width:6px; height:6px; border-radius:50%; background:#34d399; display:inline-block; }
    .ai-clear-btn {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        color: #aaa;
        border-radius: 8px;
        padding: 5px 12px;
        font-size: 0.75rem;
        cursor: pointer;
        transition: all 0.2s;
    }
    .ai-clear-btn:hover { background: rgba(248,113,113,0.15); border-color: rgba(248,113,113,0.4); color: #f87171; }

    /* Messages */
    #chat-box {
        flex: 1;
        overflow-y: auto;
        padding: 1.5rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0;
    }
    #chat-box::-webkit-scrollbar { width: 5px; }
    #chat-box::-webkit-scrollbar-track { background: transparent; }
    #chat-box::-webkit-scrollbar-thumb { background: #333; border-radius: 10px; }

    .ai-welcome {
        text-align: center;
        padding: 2rem 1rem;
        color: #555;
    }
    .ai-welcome i { font-size: 2.5rem; color: #d4af37; margin-bottom: 0.5rem; display: block; }
    .ai-welcome p { font-size: 0.85rem; }

    .chat-msg {
        max-width: 78%;
        padding: 11px 16px;
        border-radius: 14px;
        line-height: 1.6;
        font-size: 0.88rem;
        animation: msg-in 0.25s ease;
        margin-bottom: 6px;
    }
    /* Bigger gap when sender changes */
    .chat-msg.msg-user + .chat-msg.msg-ai,
    .chat-msg.msg-ai  + .chat-msg.msg-user {
        margin-top: 14px;
    }
    @@keyframes msg-in {
        from { opacity:0; transform: translateY(8px); }
        to { opacity:1; transform: translateY(0); }
    }
    .msg-user {
        margin-left: auto;
        background: linear-gradient(135deg, #d4af37, #8b6914);
        color: #000;
        border-bottom-right-radius: 4px;
        font-weight: 500;
    }
    .msg-ai {
        margin-right: auto;
        background: #1c1c22;
        color: #ddd;
        border: 1px solid rgba(255,255,255,0.07);
        border-left: 3px solid #d4af37;
        border-bottom-left-radius: 4px;
    }

    .ai-typing-indicator {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 10px 15px;
        background: #1c1c22;
        border-radius: 14px;
        border-bottom-left-radius: 4px;
        width: fit-content;
        border: 1px solid rgba(255,255,255,0.07);
        border-left: 3px solid #d4af37;
    }
    .ai-typing-dot {
        width: 7px; height: 7px;
        border-radius: 50%; background: #d4af37;
        animation: typing-bounce 1.2s infinite ease-in-out;
    }
    .ai-typing-dot:nth-child(2) { animation-delay: 0.2s; }
    .ai-typing-dot:nth-child(3) { animation-delay: 0.4s; }
    @@keyframes typing-bounce {
        0%, 60%, 100% { transform: translateY(0); }
        30% { transform: translateY(-6px); }
    }

    /* Input area - New Elegant Design */
    .ai-input-area {
        padding: 1.25rem;
        background: transparent;
        flex-shrink: 0;
    }
    .chat-bar {
        background: #0d0d0f;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 20px;
        padding: 16px 18px 12px 18px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.25);
        transition: border-color 0.25s, box-shadow 0.25s;
    }
    .chat-bar:focus-within {
        border-color: rgba(212,175,55,0.4);
        box-shadow: 0 10px 30px rgba(212,175,55,0.08);
    }
    .chat-input-wrapper {
        margin-bottom: 12px;
    }
    .chat-input-wrapper input {
        width: 100%;
        background: transparent;
        border: none;
        outline: none;
        color: #fff;
        font-size: 0.95rem;
        padding: 4px 0;
    }
    .chat-input-wrapper input::placeholder {
        color: #555;
    }
    .chat-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .chat-icons {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .chat-actions-right {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .icon-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 50%;
        cursor: pointer;
        color: #8b93a1;
        transition: all 0.25s ease;
        padding: 0;
    }
    .icon-btn:hover {
        color: #d4af37;
        background: rgba(212,175,55,0.1);
        border-color: rgba(212,175,55,0.2);
        transform: translateY(-1px);
    }
    .icon-btn svg {
        width: 16px;
        height: 16px;
        stroke: currentColor;
        stroke-width: 1.8;
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .send-btn-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        background: #d4af37;
        border: none;
        border-radius: 50%;
        cursor: pointer;
        color: #000;
        transition: all 0.25s ease;
        padding: 0;
    }
    .send-btn-icon:hover {
        background: #f0c940;
        transform: scale(1.05);
        box-shadow: 0 0 10px rgba(212,175,55,0.3);
    }
    .send-btn-icon svg {
        width: 15px;
        height: 15px;
        stroke: currentColor;
        stroke-width: 2;
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
    }


    /* Sidebar */
    .ai-sidebar {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .ai-panel {
        background: #141418;
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 16px;
        padding: 1.25rem;
    }
    .ai-panel-title {
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #d4af37;
        margin: 0 0 0.9rem;
        display: flex;
        align-items: center;
        gap: 7px;
    }
    .ai-theme-btn {
        width: 100%;
        background: #1c1c22;
        border: 1px solid rgba(255,255,255,0.1);
        color: #aaa;
        border-radius: 8px;
        padding: 7px 12px;
        font-size: 0.8rem;
        cursor: pointer;
        text-align: left;
        margin-bottom: 0.4rem;
        transition: all 0.2s;
    }
    .ai-theme-btn:hover, .ai-theme-btn.is-active { border-color: #d4af37; color: #d4af37; background: rgba(212,175,55,0.08); }

    .ai-suggestion {
        background: #1c1c22;
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 10px;
        padding: 8px 12px;
        font-size: 0.78rem;
        color: #aaa;
        cursor: pointer;
        margin-bottom: 0.4rem;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .ai-suggestion:hover { border-color: #d4af37; color: #d4af37; }
    .ai-suggestion i { color: #d4af37; font-size: 0.7rem; }
</style>

<div class="ai-wrapper">
    <!-- AI Background Layers -->
    <div class="ai-aurora"></div>
    <div class="ai-aurora-mid"></div>
    <div class="ai-dot-grid"></div>
    <canvas class="ai-bg-canvas" id="ai-nodes-canvas"></canvas>
    <div class="ai-header">
        <h1><i class="fas fa-robot me-2" style="color:#d4af37;"></i>Asistente IA</h1>
        <p>Consulta informacion de tu tienda, inventario, usuarios y mas.</p>
    </div>

    <partial name="_AdminNav" />

    <div class="ai-body">
        <!-- Chat principal -->
        <div class="ai-chat-card">
            <div class="ai-chat-header">
                <div class="ai-chat-header-left">
                    <div class="ai-avatar"><i class="fas fa-robot"></i></div>
                    <div>
                        <div class="ai-chat-name">LuxuryCo Admin AI</div>
                        <div class="ai-chat-status">Conectado &mdash; listo para analizar</div>
                    </div>
                </div>
                <button class="ai-clear-btn" onclick="clearChat()">
                    <i class="fas fa-trash-alt me-1"></i>Limpiar
                </button>
            </div>

            <div id="chat-box">
                <div class="ai-welcome" id="ai-welcome-msg">
                    <i class="fas fa-gem"></i>
                    <p>Hola, soy tu asistente inteligente de LuxuryCo.<br>
                    Puedo analizar ventas, inventario, usuarios y mas.<br>
                    <span style="color:#d4af37;">Escribe tu primera pregunta para comenzar.</span></p>
                </div>
                <div id="messages-container"></div>
                <div id="ai-typing" class="d-none">
                    <div class="ai-typing-indicator">
                        <div class="ai-typing-dot"></div>
                        <div class="ai-typing-dot"></div>
                        <div class="ai-typing-dot"></div>
                    </div>
                </div>
            </div>

            <div class="ai-input-area">
                <form id="chat-form">
                    <div class="chat-bar">
                        <div class="chat-input-wrapper">
                            <input type="text" id="user-input" placeholder="Pregunta sobre ventas, inventario, sugerencias..." autocomplete="off" required>
                        </div>
                        <div class="chat-row">
                            <div class="chat-icons">
                                <button type="button" class="icon-btn" id="btn-file-upload" title="Adjuntar archivo">
                                    <svg viewBox="0 0 24 24"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                                </button>
                                <input type="file" id="file-input" class="d-none" accept=".csv,.txt,.pdf,.jpg,.png">
                            </div>
                            <div class="chat-actions-right">
                                <button type="button" class="icon-btn" id="btn-voice" title="Dictar por voz">
                                    <svg viewBox="0 0 24 24" id="mic-svg"><path d="M12 1a4 4 0 0 0-4 4v6a4 4 0 0 0 8 0V5a4 4 0 0 0-4-4z"/><path d="M19 10v1a7 7 0 0 1-14 0v-1"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
                                </button>
                                <button type="submit" class="send-btn-icon" title="Enviar mensaje">
                                    <svg viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="ai-sidebar">
            <!-- Sugerencias rapidas -->
            <div class="ai-panel">
                <div class="ai-panel-title"><i class="fas fa-bolt"></i>Preguntas Rapidas</div>
                <div class="ai-suggestion" onclick="sendSuggestion(this)">
                    <i class="fas fa-arrow-right"></i>Cuantos productos hay en inventario?
                </div>
                <div class="ai-suggestion" onclick="sendSuggestion(this)">
                    <i class="fas fa-arrow-right"></i>Que marcas tenemos disponibles?
                </div>
                <div class="ai-suggestion" onclick="sendSuggestion(this)">
                    <i class="fas fa-arrow-right"></i>Cuantos usuarios estan registrados?
                </div>
                <div class="ai-suggestion" onclick="sendSuggestion(this)">
                    <i class="fas fa-arrow-right"></i>Cuales son los productos mas caros?
                </div>
                <div class="ai-suggestion" onclick="sendSuggestion(this)">
                    <i class="fas fa-arrow-right"></i>Que sedes estan activas?
                </div>
            </div>

            <!-- Apariencia del chat -->
            <div class="ai-panel">
                <div class="ai-panel-title"><i class="fas fa-paint-brush"></i>Apariencia</div>
                <div class="ai-theme-btn is-active" onclick="setTheme('#0d0d0d', this)">Luxury Dark</div>
                <div class="ai-theme-btn" onclick="setTheme('#0f1117', this)">Deep Navy</div>
                <div class="ai-theme-btn" onclick="setTheme('#1a1208', this)">Warm Bronze</div>
            </div>

            <!-- Info -->
            <div class="ai-panel" style="border-color:rgba(212,175,55,0.2);">
                <div class="ai-panel-title"><i class="fas fa-info-circle"></i>Sobre la IA</div>
                <p style="font-size:0.78rem; color:#666; margin:0; line-height:1.6;">
                    Conectado a la base de datos de LuxuryCo en tiempo real via API. Responde preguntas sobre productos, inventario, usuarios y sedes.
                </p>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        loadPreferences();

        var chatForm = document.getElementById('chat-form');
        var userInput = document.getElementById('user-input');
        var messagesContainer = document.getElementById('messages-container');
        var aiTyping = document.getElementById('ai-typing');
        var chatBox = document.getElementById('chat-box');
        var btnVoice = document.getElementById('btn-voice');
        var btnFile = document.getElementById('btn-file-upload');
        var fileInput = document.getElementById('file-input');

        // SignalR
        var connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/adminNotifications")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveNotification", function(message) {
            appendMessage("Notificacion del Sistema: " + message, 'ai');
        });
        connection.start().catch(function(err) { console.error("SignalR error:", err.toString()); });

        // File upload
        btnFile.addEventListener('click', function() { fileInput.click(); });
        fileInput.addEventListener('change', async function(e) {
            var file = e.target.files[0];
            if (!file) return;
            appendMessage('Subiendo archivo: ' + file.name + '...', 'user');
            var formData = new FormData();
            formData.append('file', file);
            try {
                var response = await fetch('/api/Ai/upload-context-file', { method:'POST', body:formData });
                if (response.ok) {
                    var data = await response.json();
                    userInput.value += '[Contexto: ' + data.secureReferenceUrl + '] ';
                    appendMessage('Archivo analizado. Referencia agregada al mensaje.', 'ai');
                } else {
                    appendMessage('Error al subir el archivo: ' + response.statusText, 'ai');
                }
            } catch (err) {
                appendMessage('Error de conexion al subir archivo.', 'ai');
            }
        });

        // Voice
        var mediaRecorder, audioChunks = [];
        btnVoice.addEventListener('mousedown', async function() {
            try {
                var stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                mediaRecorder = new MediaRecorder(stream);
                mediaRecorder.ondataavailable = function(e) { audioChunks.push(e.data); };
                mediaRecorder.onstop = async function() {
                    var audioBlob = new Blob(audioChunks, { type:'audio/webm' });
                    audioChunks = [];
                    var formData = new FormData();
                    formData.append('file', audioBlob, 'voice.webm');
                    aiTyping.classList.remove('d-none');
                    try {
                        var res = await fetch('/api/Ai/transcribe', { method:'POST', body:formData });
                        if (res.ok) {
                            var data = await res.json();
                            userInput.value += (userInput.value ? ' ' : '') + data.text;
                        }
                    } catch(err) {} finally { aiTyping.classList.add('d-none'); }
                };
                mediaRecorder.start();
                btnVoice.style.color = '#f87171';
                btnVoice.style.backgroundColor = 'rgba(248,113,113,0.1)';
            } catch(err) { alert("Permiso de microfono denegado."); }
        });
        btnVoice.addEventListener('mouseup', function() {
            if (mediaRecorder && mediaRecorder.state !== 'inactive') {
                mediaRecorder.stop();
                btnVoice.style.color = '';
                btnVoice.style.backgroundColor = '';
                mediaRecorder.stream.getTracks().forEach(function(t){ t.stop(); });
            }
        });

        // Theme selector
        document.querySelectorAll('.ai-theme-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.ai-theme-btn').forEach(function(b){ b.classList.remove('is-active'); });
                this.classList.add('is-active');
            });
        });

        // Submit form
        chatForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            var text = userInput.value.trim();
            if (!text) return;

            var welcome = document.getElementById('ai-welcome-msg');
            if (welcome) welcome.remove();

            appendMessage(text, 'user');
            userInput.value = '';
            aiTyping.classList.remove('d-none');
            chatBox.scrollTop = chatBox.scrollHeight;

            try {
                var response = await fetch('/Admin/SendAiMessage', {
                    method:'POST',
                    credentials:'include',
                    headers:{ 'Content-Type':'application/json' },
                    body: JSON.stringify({ message: text })
                });
                var rawText = await response.text();
                var data;
                try { data = JSON.parse(rawText); } catch {
                    appendMessage("Error de formato en la respuesta de la IA.", 'ai');
                    return;
                }
                if (response.ok) {
                    appendMessage(data.reply, 'ai');
                } else {
                    appendMessage("Error: " + (data.message || "Error interno."), 'ai');
                }
            } catch(error) {
                appendMessage("Error de conexion: " + error.message, 'ai');
            } finally {
                aiTyping.classList.add('d-none');
                chatBox.scrollTop = chatBox.scrollHeight;
            }
        });
    });

    function appendMessage(text, sender) {
        var welcome = document.getElementById('ai-welcome-msg');
        if (welcome) welcome.remove();

        var div = document.createElement('div');
        div.className = 'chat-msg msg-' + sender;
        var formatted = text
            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
            .replace(/\n/g, '<br>');
        div.innerHTML = formatted;
        document.getElementById('messages-container').appendChild(div);
        document.getElementById('chat-box').scrollTop = 999999;
    }

    function clearChat() {
        document.getElementById('messages-container').innerHTML = '';
        var chatBox = document.getElementById('chat-box');
        if (!document.getElementById('ai-welcome-msg')) {
            var welcome = document.createElement('div');
            welcome.id = 'ai-welcome-msg';
            welcome.className = 'ai-welcome';
            welcome.innerHTML = '<i class="fas fa-gem"></i><p>Chat limpiado. <span style="color:#d4af37;">Haz una nueva pregunta.</span></p>';
            chatBox.insertBefore(welcome, chatBox.firstChild);
        }
    }

    function sendSuggestion(el) {
        var text = el.textContent.trim();
        document.getElementById('user-input').value = text;
        document.getElementById('chat-form').dispatchEvent(new Event('submit', { bubbles:true, cancelable:true }));
    }

    function setTheme(color, el) {
        document.getElementById('chat-box').style.background = color;
        document.querySelectorAll('.ai-theme-btn').forEach(function(b){ b.classList.remove('is-active'); });
        if (el) el.classList.add('is-active');
        localStorage.setItem('ai_chat_bg', color);
    }

    function loadPreferences() {
        var savedBg = localStorage.getItem('ai_chat_bg');
        if (savedBg) {
            var chatBox = document.getElementById('chat-box');
            if (chatBox) chatBox.style.background = savedBg;
        }
    }
</script>

<script>
    /* ── AI Neural Network Canvas Background ── */
    (function() {
        const canvas = document.getElementById('ai-nodes-canvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        let W, H, nodes = [], animId;

        const COLORS = [
            'rgba(212,175,55,',   // gold
            'rgba(100,80,255,',   // purple-blue
            'rgba(60,180,255,',   // cyan
            'rgba(0,220,150,',    // teal
        ];

        function resize() {
            W = canvas.width = window.innerWidth;
            H = canvas.height = window.innerHeight;
        }

        function makeNode() {
            const c = COLORS[Math.floor(Math.random() * COLORS.length)];
            return {
                x: Math.random() * W,
                y: Math.random() * H,
                r: Math.random() * 1.8 + 0.6,
                vx: (Math.random() - 0.5) * 0.35,
                vy: (Math.random() - 0.5) * 0.35,
                color: c,
                alpha: Math.random() * 0.5 + 0.3,
                pulse: Math.random() * Math.PI * 2,
                pulseSpeed: Math.random() * 0.02 + 0.008
            };
        }

        function init() {
            resize();
            nodes = [];
            const count = Math.floor((W * H) / 18000);
            for (let i = 0; i < Math.min(count, 80); i++) nodes.push(makeNode());
        }

        function draw() {
            ctx.clearRect(0, 0, W, H);
            const LINK_DIST = 160;

            // Draw connections
            for (let i = 0; i < nodes.length; i++) {
                for (let j = i + 1; j < nodes.length; j++) {
                    const dx = nodes[i].x - nodes[j].x;
                    const dy = nodes[i].y - nodes[j].y;
                    const dist = Math.sqrt(dx*dx + dy*dy);
                    if (dist < LINK_DIST) {
                        const alpha = (1 - dist / LINK_DIST) * 0.15;
                        ctx.beginPath();
                        ctx.moveTo(nodes[i].x, nodes[i].y);
                        ctx.lineTo(nodes[j].x, nodes[j].y);
                        ctx.strokeStyle = nodes[i].color + alpha + ')';
                        ctx.lineWidth = 0.6;
                        ctx.stroke();
                    }
                }
            }

            // Draw nodes
            nodes.forEach(n => {
                n.pulse += n.pulseSpeed;
                const pa = n.alpha + Math.sin(n.pulse) * 0.2;
                ctx.beginPath();
                ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
                ctx.fillStyle = n.color + pa + ')';
                ctx.fill();

                // Glow
                const grad = ctx.createRadialGradient(n.x, n.y, 0, n.x, n.y, n.r * 5);
                grad.addColorStop(0, n.color + pa * 0.4 + ')');
                grad.addColorStop(1, n.color + '0)');
                ctx.beginPath();
                ctx.arc(n.x, n.y, n.r * 5, 0, Math.PI * 2);
                ctx.fillStyle = grad;
                ctx.fill();
            });

            // Move nodes
            nodes.forEach(n => {
                n.x += n.vx;
                n.y += n.vy;
                if (n.x < -20) n.x = W + 20;
                if (n.x > W + 20) n.x = -20;
                if (n.y < -20) n.y = H + 20;
                if (n.y > H + 20) n.y = -20;
            });

            animId = requestAnimationFrame(draw);
        }

        window.addEventListener('resize', () => { cancelAnimationFrame(animId); init(); draw(); });
        init();
        draw();
    })();
</script>
