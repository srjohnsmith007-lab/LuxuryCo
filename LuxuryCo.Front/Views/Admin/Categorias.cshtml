@{
    ViewData["Title"] = "Categorías · Admin LuxuryCo";
}

<style>
    .cat-input {
        background-color: #0d0d0f !important;
        border: 1px solid rgba(255,255,255,0.1) !important;
        color: #fff !important;
        border-radius: 8px !important;
        padding: 12px 15px !important;
    }
    .cat-input:focus {
        border-color: #d4af37 !important;
        box-shadow: 0 0 0 0.15rem rgba(212,175,55,0.25) !important;
        background-color: #0d0d0f !important;
    }
    .cat-input::placeholder { color: #555 !important; }
    .cat-quick {
        background-color: #1c1c22;
        border: 1px solid rgba(255,255,255,0.1);
        color: #aaa;
        border-radius: 8px;
        font-size: 0.75rem;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 6px 12px;
        transition: all 0.2s;
    }
    .cat-quick:hover {
        background-color: rgba(212,175,55,0.15);
        border-color: #d4af37;
        color: #d4af37;
    }
</style>

<div class="adm-page-bg">
    <div class="adm-page-header">
        <div class="adm-page-title-area">
            <h1><i class="fas fa-layer-group me-2" style="color:var(--adm-gold);"></i>CATEGORÍAS</h1>
            <p>Estructura y clasificación del catálogo de productos públicos.</p>
        </div>
    </div>

    <!-- Pestañas de Navegación Admin -->
    <partial name="_AdminNav" />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-dismissible fade show mx-4" role="alert" style="border-radius:12px;background:rgba(52, 211, 153, 0.1);color:#34d399;border:1px solid rgba(52, 211, 153, 0.2); margin: 1.5rem 2.5rem 0;">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-dismissible fade show mx-4" role="alert" style="border-radius:12px;background:rgba(248, 113, 113, 0.1);color:#f87171;border:1px solid rgba(248, 113, 113, 0.2); margin: 1.5rem 2.5rem 0;">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4 px-4" style="margin-top: 0.5rem; padding: 0 1rem;">
        <!-- Lista de Categorías -->
        <div class="col-lg-8">
            <div class="adm-container-card no-padding" style="margin:0;">
                <div class="d-flex align-items-center justify-content-between px-4 py-3" style="border-bottom: 1px solid rgba(255,255,255,0.07);">
                    <h5 class="mb-0 fw-bold" style="letter-spacing: 1px; font-size: 0.85rem; text-transform: uppercase;">Categorías del Catálogo</h5>
                    <span class="badge" style="background-color: rgba(255,255,255,0.05); color: #888; font-size: 0.75rem;">@(ViewBag.Categorias?.Count ?? 0) categorías</span>
                </div>
                <div class="table-responsive">
                    <table class="adm-custom-table">
                        <thead>
                            <tr>
                                <th style="padding-left: 2rem;">#</th>
                                <th>Nombre</th>
                                <th>Descripción</th>
                                <th style="padding-right: 2rem;" class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.Categorias != null)
                            {
                                foreach (var cat in ViewBag.Categorias as List<LuxuryCo.Front.ViewModels.CategoriaViewModel> ?? new())
                                {
                                    <tr>
                                        <td style="padding-left: 2rem;" class="text-secondary font-size: 0.8rem;">@cat.id_categoria</td>
                                        <td class="fw-bold text-white">
                                            @if (cat.nombre == "Hombre" || cat.nombre == "Mujer" || cat.nombre == "Accesorios")
                                            {
                                                <span class="me-2" style="color: #d4af37;">●</span>
                                            }
                                            @cat.nombre
                                        </td>
                                        <td class="text-secondary" style="font-size: 0.85rem;">@(cat.descripcion ?? "—")</td>
                                        <td style="padding-right: 2rem;" class="text-end">
                                            <form asp-action="EliminarCategoria" asp-route-id="@cat.id_categoria" method="post"
                                                  onsubmit="return confirm('¿Eliminar la categoría «@cat.nombre»? Solo es posible si no tiene productos asignados.')" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn-adm-danger-outline border-0 py-1 px-3">
                                                    <i class="fas fa-trash-alt me-1"></i> Eliminar
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-secondary">No hay categorías registradas.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Formulario Nueva Categoría -->
        <div class="col-lg-4">
            <div class="adm-container-card" style="margin:0;">
                <h5 class="fw-bold mb-4" style="letter-spacing: 1px; font-size: 0.85rem; text-transform: uppercase; color: #f0f0f0;">Nueva Categoría</h5>
                <form asp-action="CrearCategoria" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label small fw-bold" style="color: #888; letter-spacing: 0.5px; text-transform: uppercase; font-size: 0.72rem;">Nombre *</label>
                        <input name="Nombre" type="text" class="form-control cat-input" placeholder="Ej: Hombre, Mujer..." required />
                    </div>
                    <div class="mb-4">
                        <label class="form-label small fw-bold" style="color: #888; letter-spacing: 0.5px; text-transform: uppercase; font-size: 0.72rem;">Descripción (opcional)</label>
                        <textarea name="Descripcion" class="form-control cat-input" rows="3" placeholder="Ropa para hombre..."></textarea>
                    </div>
                    <button type="submit" class="btn-adm-gold w-100 py-3" style="justify-content: center; font-size: 0.85rem;">
                        <i class="fas fa-plus"></i> AGREGAR CATEGORÍA
                    </button>
                </form>

                <hr style="border-color: rgba(255,255,255,0.08); margin: 1.5rem 0;">

                <div>
                    <p class="small mb-3" style="color: #666; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 1px;">Sugerencias Rápidas</p>
                    <div class="d-flex flex-wrap gap-2">
                        <button onclick="fillName('Hombre')" class="cat-quick" type="button">Hombre</button>
                        <button onclick="fillName('Mujer')" class="cat-quick" type="button">Mujer</button>
                        <button onclick="fillName('Accesorios')" class="cat-quick" type="button">Accesorios</button>
                    </div>
                </div>
            </div>

            <!-- Nota -->
            <div class="mt-3 p-3" style="background-color: rgba(212,175,55,0.05); border: 1px solid rgba(212,175,55,0.15); font-size: 0.8rem; color: #d4af37; border-radius: 12px;">
                <i class="fas fa-info-circle me-2"></i>
                Las categorías marcadas con <span style="color: #d4af37;">●</span> aparecen destacadas en la tienda pública.
            </div>
        </div>
    </div>
</div>

<script>
    function fillName(name) {
        document.querySelector('input[name="Nombre"]').value = name;
    }
</script>
