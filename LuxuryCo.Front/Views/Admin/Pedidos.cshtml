@using LuxuryCo.Front.ViewModels
@model List<PedidoAdminViewModel>
@{
    ViewData["Title"] = "Gestión de Pedidos · Admin LuxuryCo";
}

<div class="adm-page-bg">
    <div class="adm-page-header">
        <div class="adm-page-title-area">
            <h1><i class="fas fa-shopping-cart me-2" style="color:var(--adm-gold, #d4af37);"></i>GESTIÓN DE PEDIDOS</h1>
            <p>Monitoreo en tiempo real de compras realizadas por clientes en la plataforma.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportReport" asp-route-type="VENTAS" class="btn-adm-gold">
                <i class="fas fa-file-excel me-1"></i> DESCARGAR REPORTE
            </a>
        </div>
    </div>

    <!-- Pestañas de Navegación Admin -->
    <partial name="_AdminNav" />

    <div class="adm-container-card no-padding">
        <div class="table-responsive">
            <table class="adm-custom-table">
                <thead>
                    <tr>
                        <th style="width: 100px; padding-left: 2rem;">PEDIDO</th>
                        <th>FECHA Y HORA</th>
                        <th>CLIENTE</th>
                        <th>DIRECCIÓN ENVÍO</th>
                        <th class="text-end">TOTAL</th>
                        <th class="text-center">MÉTODO PAGO</th>
                        <th class="text-center">ESTADO</th>
                        <th style="padding-right: 2rem;" class="text-end">DETALLES</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        @foreach (var p in Model)
                        {
                            <tr id="pedido-@p.IdPedido">
                                <td style="padding-left: 2rem;" class="fw-bold text-warning">#PED-@p.IdPedido</td>
                                <td>
                                    <div class="text-white small fw-bold"><i class="far fa-clock me-1 text-secondary"></i>@p.FechaPedido.ToString("dd/MM/yyyy HH:mm")</div>
                                </td>
                                <td>
                                    <div>
                                        <div class="fw-bold text-white">@p.NombreUsuario</div>
                                        <div class="small text-secondary"><i class="far fa-envelope me-1"></i>@p.EmailUsuario</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="small text-secondary" style="max-width: 250px;">
                                        <i class="fas fa-map-marker-alt me-1 text-warning"></i>@p.DireccionEnvio
                                    </div>
                                </td>
                                <td class="text-end fw-bold text-warning" style="font-size: 1rem;">
                                    $@string.Format("{0:N0}", p.Total)
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-dark border border-secondary text-info px-2 py-1">
                                        <i class="fas fa-shield-alt me-1"></i>@p.MetodoPagoNombre
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge @(p.EstadoNombre.Contains("Completado") || p.EstadoNombre.Contains("Aprobado") ? "bg-success" : "bg-warning text-dark") px-3 py-2">
                                        @p.EstadoNombre
                                    </span>
                                </td>
                                <td style="padding-right: 2rem;" class="text-end">
                                    <button class="btn btn-sm btn-outline-warning rounded-circle me-1" title="Ver Detalles del Pedido" onclick="verDetallePedido(@p.IdPedido, '@p.NombreUsuario', '@p.EmailUsuario', '@p.FechaPedido.ToString("dd/MM/yyyy HH:mm")', '@p.DireccionEnvio', '@string.Format("{0:N0}", p.Total)')">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <a asp-action="Facturas" asp-route-highlight="factura-@(p.IdPedido + 4000)" class="btn btn-sm btn-warning fw-bold px-2 py-1" title="Ver Factura de este Pedido">
                                        <i class="fas fa-file-invoice me-1"></i> Factura
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-secondary">
                                <i class="fas fa-shopping-cart fa-3x mb-3 d-block opacity-25"></i>
                                No se registraron pedidos en el sistema.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Detalle de Pedido -->
<div class="modal fade" id="modalDetallePedido" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark text-white border-warning">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold text-warning"><i class="fas fa-receipt me-2"></i>DETALLE DEL PEDIDO <span id="mdlPedidoId"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-4 p-3 rounded" style="background-color: #111; border: 1px solid #222;">
                    <div class="col-md-6">
                        <label class="text-secondary small">Cliente:</label>
                        <div class="fw-bold" id="mdlClienteNombre"></div>
                        <div class="small text-secondary" id="mdlClienteEmail"></div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-secondary small">Fecha y Hora:</label>
                        <div class="fw-bold" id="mdlFechaHora"></div>
                    </div>
                    <div class="col-12 border-top border-secondary pt-2">
                        <label class="text-secondary small">Dirección de Entrega:</label>
                        <div class="small text-white" id="mdlDireccion"></div>
                    </div>
                </div>

                <h6 class="fw-bold text-warning mb-3"><i class="fas fa-box me-2"></i>Artículos Solicitados</h6>
                <div class="table-responsive mb-3">
                    <table class="table table-dark table-sm align-middle">
                        <thead>
                            <tr class="text-secondary small">
                                <th>Prenda / Producto</th>
                                <th class="text-center">Cant.</th>
                                <th class="text-end">Precio Unit.</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody id="mdlProductosList">
                            <tr>
                                <td><i class="fas fa-tshirt me-2 text-warning"></i>Chaqueta Cuero Premium Luxury</td>
                                <td class="text-center">1</td>
                                <td class="text-end">$850,000</td>
                                <td class="text-end fw-bold text-warning">$850,000</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center p-3 rounded" style="background: rgba(212,175,55,0.1); border: 1px solid rgba(212,175,55,0.3);">
                    <span class="h6 mb-0 text-white">Total Pagado Wompi:</span>
                    <span class="h5 mb-0 fw-bold text-warning" id="mdlTotal"></span>
                </div>
            </div>
            <div class="modal-footer border-secondary justify-content-between">
                <button type="button" class="btn btn-warning btn-sm fw-bold" id="btnMdlVerFactura" onclick="irAFacturaModal()">
                    <i class="fas fa-file-invoice me-1"></i> Ver Factura de este Pedido
                </button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<script>
    var currentMdlPedidoId = 0;
    function verDetallePedido(id, cliente, email, fecha, direccion, total) {
        currentMdlPedidoId = id;
        document.getElementById("mdlPedidoId").innerText = "#PED-" + id;
        document.getElementById("mdlClienteNombre").innerText = cliente;
        document.getElementById("mdlClienteEmail").innerText = email;
        document.getElementById("mdlFechaHora").innerText = fecha;
        document.getElementById("mdlDireccion").innerText = direccion;
        document.getElementById("mdlTotal").innerText = "$" + total;
        
        var modal = new bootstrap.Modal(document.getElementById('modalDetallePedido'));
        modal.show();
    }

    function irAFacturaModal() {
        window.location.href = '/Admin/Facturas';
    }
</script>
