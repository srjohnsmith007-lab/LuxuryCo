@using LuxuryCo.Front.ViewModels
@model List<ProductoViewModel>
@{
    ViewData["Title"] = "Catálogo de Productos · Admin LuxuryCo";
}

<div class="adm-page-bg">
    <div class="adm-page-header">
        <div class="adm-page-title-area">
            <h1><i class="fas fa-box-open me-2" style="color:var(--adm-gold);"></i>PRODUCTOS</h1>
            <p>Gestión de inventario y catálogo exclusivo de la tienda.</p>
        </div>
        <a asp-action="Create" class="btn-adm-gold">
            <i class="fas fa-plus"></i> NUEVO PRODUCTO
        </a>
    </div>

    <!-- Pestañas de Navegación Admin -->
    <partial name="_AdminNav" />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mx-4" role="alert" style="border-radius: 12px; background-color: rgba(52, 211, 153, 0.1); color: #34d399; border: 1px solid rgba(52, 211, 153, 0.2); margin: 1.5rem 2.5rem 0;">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="adm-container-card no-padding">
        <div class="table-responsive">
            <table class="adm-custom-table">
                <thead>
                    <tr>
                        <th style="width: 80px; padding-left: 2rem;">ID</th>
                        <th>PRODUCTO</th>
                        <th>CATEGORÍA</th>
                        <th>MARCA</th>
                        <th class="text-end">PRECIO</th>
                        <th class="text-center">STOCK</th>
                        <th class="text-center">ESTADO</th>
                        <th style="padding-right: 2rem;" class="text-end">ACCIONES</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        @foreach (var p in Model)
                        {
                            <tr id="item-@p.IdProducto">
                                <td style="padding-left: 2rem;" class="text-secondary">#@p.IdProducto</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-secondary rounded-3 me-3" style="width: 45px; height: 45px; overflow: hidden; background: #222 url('@(p.ImagenPrincipalUrl ?? "https://via.placeholder.com/100")') center/cover no-repeat; border: 1px solid rgba(255,255,255,0.1);"></div>
                                        <div>
                                            <div class="fw-bold text-white">@p.Nombre</div>
                                            <div class="small text-secondary">@p.Referencia</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge bg-dark border border-secondary text-secondary fw-normal px-2 py-1">@p.CategoriaNombre</span></td>
                                <td>@p.MarcaNombre</td>
                                <td class="text-end fw-bold text-white">$@(string.Format("{0:N0}", p.Precio))</td>
                                <td class="text-center">@p.Stock</td>
                                <td class="text-center">
                                    @if (p.Activo)
                                    {
                                        <span class="adm-badge-active"><i class="fas fa-check-circle"></i> Activo</span>
                                    }
                                    else
                                    {
                                        <span class="adm-badge-inactive"><i class="fas fa-times-circle"></i> Inactivo</span>
                                    }
                                </td>
                                <td style="padding-right: 2rem;" class="text-end">
                                    <div class="btn-group">
                                        <form asp-action="ToggleStatus" asp-route-id="@p.IdProducto" method="post" class="d-inline m-0 p-0">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary border-0 text-secondary" style="font-size: 0.9rem;" title="@(p.Activo ? "Desactivar" : "Activar")">
                                                <i class="@(p.Activo ? "fas fa-eye-slash" : "fas fa-eye")"></i>
                                            </button>
                                        </form>
                                        <a asp-action="Edit" asp-route-id="@p.IdProducto" class="btn btn-sm btn-outline-secondary border-0 text-secondary" style="font-size: 0.9rem;" title="Editar"><i class="fas fa-edit"></i></a>
                                        <button type="button" class="btn btn-sm btn-outline-secondary border-0 text-danger" style="font-size: 0.9rem;" onclick="confirmDelete(@p.IdProducto, '@p.Nombre')" title="Eliminar">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-secondary italic">
                                No hay productos en el catálogo. Comienza agregando uno nuevo.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal confirmación borrado -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0" style="background-color: #141418; color: #fff; border-radius: 16px; border: 1px solid rgba(255,255,255,0.08);">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold" style="font-family: 'Playfair Display', serif;">Confirmar Eliminación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ¿Estás seguro de que deseas eliminar permanentemente el producto <strong id="deleteProdName"></strong>? <br>
                <strong>Nota:</strong> Esta acción no se puede deshacer. (Si deseas conservar el historial pero ocultarlo de la tienda, utiliza el botón del "Ojo" para desactivarlo y mantenerlo registrado).
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-adm-outline" data-bs-dismiss="modal">Cancelar</button>
                <form asp-action="Delete" method="post" id="deleteForm">
                    <input type="hidden" name="id" id="deleteId" />
                    <button type="submit" class="btn btn-danger" style="border-radius: 8px; padding: 8px 20px;">Eliminar Permanentemente</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function confirmDelete(id, name) {
        document.getElementById('deleteProdName').innerText = name;
        document.getElementById('deleteId').value = id;
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    }
</script>
