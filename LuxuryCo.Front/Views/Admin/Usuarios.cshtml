@model List<LuxuryCo.Front.ViewModels.UsuarioViewModel>
@{
    ViewData["Title"] = "Usuarios · Admin LuxuryCo";
}

<div class="adm-page-bg">

    <div class="adm-page-header">
        <div class="adm-page-title-area">
            <h1><i class="fas fa-users me-2" style="color:var(--adm-gold);"></i>USUARIOS</h1>
            <p>Gestión y control de cuentas activas en la plataforma.</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="badge border border-secondary text-secondary px-3 py-2" style="background-color: rgba(255,255,255,0.05); font-weight: normal; letter-spacing: 1px; font-size: 0.8rem; border-radius: 8px;">
                <i class="fas fa-users me-2"></i> @(Model?.Count ?? 0) REGISTRADOS
            </span>
            <a asp-action="CrearUsuario" asp-controller="Admin" class="btn-adm-gold">
                <i class="fas fa-plus"></i> NUEVO USUARIO
            </a>
        </div>
    </div>

    <!-- Pestañas de Navegación Admin -->
    <partial name="_AdminNav" />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-dismissible fade show mx-4" role="alert" style="border-radius:12px;background:rgba(52, 211, 153, 0.1);color:#34d399;border:1px solid rgba(52, 211, 153, 0.2); margin: 1.5rem 2.5rem 0;">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-dismissible fade show mx-4" role="alert" style="border-radius:12px;background:rgba(248, 113, 113, 0.1);color:#f87171;border:1px solid rgba(248, 113, 113, 0.2); margin: 1.5rem 2.5rem 0;">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="adm-container-card no-padding">
        <div class="table-responsive">
            <table class="adm-custom-table">
                <thead>
                    <tr>
                        <th style="padding-left: 2rem; width: 80px;">ID</th>
                        <th>NOMBRE COMPLETO</th>
                        <th>EMAIL</th>
                        <th class="text-center">ROL</th>
                        <th class="text-center">SEDE</th>
                        <th class="text-center">ESTADO</th>
                        <th>REGISTRO</th>
                        <th style="padding-right: 2rem;" class="text-end">ACCIONES</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        @foreach (var u in Model)
                        {
                            var nombre = string.Join(" ", new[] { u.Nombre, u.Apellido }.Where(s => !string.IsNullOrEmpty(s)));
                            var fechaStr = u.FechaRegistro?.ToString("dd/MM/yyyy") ?? "-";

                            <tr id="user-@u.IdUsuario">
                                <td style="padding-left: 2rem;" class="text-secondary">#@u.IdUsuario</td>
                                <td><strong class="text-white">@(string.IsNullOrEmpty(nombre) ? "Usuario Sin Nombre" : nombre)</strong></td>
                                <td class="text-secondary">@(u.Email ?? "-")</td>
                                <td class="text-center">
                                    <span class="badge @(u.Rol == "ADMIN" ? "bg-light text-dark" : "bg-dark border border-secondary text-secondary")">@(u.Rol ?? "-")</span>
                                </td>
                                <td class="text-center text-secondary small">
                                    <i class="fas fa-store-alt me-1"></i> @(u.SedeNombre ?? "Global")
                                </td>
                                <td class="text-center">
                                    @if (u.Activo)
                                    {
                                        <span class="adm-badge-active"><i class="fas fa-check-circle"></i> Activo</span>
                                    }
                                    else
                                    {
                                        <span class="adm-badge-inactive"><i class="fas fa-times-circle"></i> Inactivo</span>
                                    }
                                </td>
                                <td class="text-secondary small">@fechaStr</td>
                                <td style="padding-right: 2rem;" class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="EditarUsuario" asp-route-id="@u.IdUsuario" class="btn btn-sm btn-outline-secondary border-0 text-secondary" style="font-size:0.9rem;" title="Editar">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <form method="post" asp-action="ToggleUsuario" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@u.IdUsuario" />
                                            <input type="hidden" name="activar" value="@(u.Activo ? "false" : "true")" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary border-0 @(u.Activo ? "text-danger" : "text-success")" style="font-size:0.9rem;" title="Cambiar Estado">
                                                @if(u.Activo)
                                                {
                                                    <i class="fas fa-ban"></i>
                                                }
                                                else
                                                {
                                                    <i class="fas fa-check"></i>
                                                }
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-secondary p-5 text-center" style="font-style: italic;">
                                No hay usuarios registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
