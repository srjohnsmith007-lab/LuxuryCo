@model LuxuryCo.Front.ViewModels.CheckoutRequestViewModel
@{
    ViewData["Title"] = "Paso Final - Checkout";
    var cart = ViewBag.CartSummary as LuxuryCo.Front.ViewModels.CarritoViewModel;
    decimal envio = cart != null && cart.Total > 500000 ? 0 : 25000;
    decimal iva = cart != null ? cart.Total * 0.19m : 0;
    decimal totalFinal = cart != null ? cart.Total + iva + envio : 0;
}

<div class="container-fluid py-5" style="background-color: #000; min-height: 100vh; color: #fff;">
    <div class="container">
        <div class="text-center mb-5">
            <h1 class="display-6 fw-bold" style="font-family: 'Playfair Display', serif; letter-spacing: 2px;">FINALIZAR COMPRA</h1>
            <p class="text-secondary">Información encriptada mediante protocolo SSL de 256 bits.</p>
        </div>

        @if (TempData["CheckoutError"] != null)
        {
            <div class="alert alert-danger bg-dark text-danger border-danger rounded-0 mb-4 shadow-sm">
                <i class="fas fa-exclamation-triangle me-2"></i> @TempData["CheckoutError"]
            </div>
        }

        <div class="row g-5">
            <!-- Checkout Form -->
            <div class="col-lg-7">
                <form asp-action="PlaceOrder" method="post" id="checkoutForm">
                    <!-- IDEMPOTENCY TOKEN MOCK -->
                    <input type="hidden" asp-for="IdempotencyKey" id="IdempotencyKey" />
                    <input type="hidden" asp-for="CardToken" value="tok_mock_2026_vip" />

                    <!-- PASO 1: ENVÍO -->
                    <h4 class="fw-bold mb-4" style="border-bottom: 1px solid #333; padding-bottom: 10px; color: var(--gold, #d4af37);">1. Detalles de Envío</h4>
                    
                    <div class="row g-3 mb-5">
                        <div class="col-12">
                            <label class="form-label text-secondary small">Dirección de Entrega</label>
                            <input asp-for="DireccionLinea1" class="form-control bg-dark border-secondary text-white rounded-0 py-3" placeholder="Ej. Calle 123 #45-67" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary small">Ciudad</label>
                            <input asp-for="Ciudad" class="form-control bg-dark border-secondary text-white rounded-0 py-3" placeholder="Bogotá, Medellín..." required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary small">Código Postal</label>
                            <input asp-for="CodigoPostal" class="form-control bg-dark border-secondary text-white rounded-0 py-3" placeholder="Postcode" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary small">Teléfono de Contacto</label>
                            <input asp-for="Telefono" class="form-control bg-dark border-secondary text-white rounded-0 py-3" placeholder="(+57) 300 000 0000" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary small">Instrucciones Adicionales</label>
                            <input asp-for="Referencias" class="form-control bg-dark border-secondary text-white rounded-0 py-3" placeholder="Ej. Dejar en recepción" />
                        </div>
                    </div>

                    <!-- PASO 2: PAGO (WOMPI INTEGRATION) -->
                    <h4 class="fw-bold mb-4" style="border-bottom: 1px solid #333; padding-bottom: 10px; color: var(--gold, #d4af37);">2. Método de Pago</h4>
                    <div class="p-4 mb-4" style="background-color: #0a0a0a; border: 1px solid #222; border-radius: 8px;">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="text-white fw-bold"><i class="fas fa-shield-alt me-2 text-warning"></i> Pasarela Oficial Wompi Colombia</span>
                            <span class="badge bg-dark border border-secondary text-warning" style="font-size: 0.75rem;">
                                Transacción Segura SSL 256-bit
                            </span>
                        </div>
                        
                        <!-- Selector de Método de Pago Wompi -->
                        <div class="row g-2 mb-4" id="wompiPaymentSelector">
                            <div class="col-6 col-md-3">
                                <label class="w-100 cursor-pointer text-center p-3 rounded" style="background: #151515; border: 2px solid var(--gold, #d4af37);" id="lbl-card">
                                    <input type="radio" name="wompiMethod" value="CARD" checked class="d-none" onchange="switchWompiMethod('CARD')">
                                    <i class="fas fa-credit-card fa-2x mb-2 d-block text-warning"></i>
                                    <span class="d-block small text-white fw-bold">Tarjeta Crédito</span>
                                </label>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="w-100 cursor-pointer text-center p-3 rounded" style="background: #151515; border: 1px solid #333;" id="lbl-pse">
                                    <input type="radio" name="wompiMethod" value="PSE" class="d-none" onchange="switchWompiMethod('PSE')">
                                    <i class="fas fa-university fa-2x mb-2 d-block text-info"></i>
                                    <span class="d-block small text-white fw-bold">PSE (Bancos)</span>
                                </label>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="w-100 cursor-pointer text-center p-3 rounded" style="background: #151515; border: 1px solid #333;" id="lbl-nequi">
                                    <input type="radio" name="wompiMethod" value="NEQUI" class="d-none" onchange="switchWompiMethod('NEQUI')">
                                    <i class="fas fa-mobile-alt fa-2x mb-2 d-block style-nequi" style="color: #ff007f;"></i>
                                    <span class="d-block small text-white fw-bold">Nequi</span>
                                </label>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="w-100 cursor-pointer text-center p-3 rounded" style="background: #151515; border: 1px solid #333;" id="lbl-bancolombia">
                                    <input type="radio" name="wompiMethod" value="BANCOLOMBIA" class="d-none" onchange="switchWompiMethod('BANCOLOMBIA')">
                                    <i class="fas fa-building fa-2x mb-2 d-block text-success"></i>
                                    <span class="d-block small text-white fw-bold">Bancolombia</span>
                                </label>
                            </div>
                        </div>

                        <!-- Panel Dinámico según el Método -->
                        <div id="wompi-panel-CARD" class="wompi-panel">
                            <div class="mb-3">
                                <label class="form-label text-secondary small">Número de Tarjeta (Visa / Mastercard / Amex)</label>
                                <input type="text" class="form-control bg-dark border-secondary text-white rounded-0 py-2" placeholder="4532 •••• •••• 8901" required />
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <label class="form-label text-secondary small">Fecha Vencimiento</label>
                                    <input type="text" class="form-control bg-dark border-secondary text-white rounded-0 py-2" placeholder="MM/AA" required />
                                </div>
                                <div class="col-6">
                                    <label class="form-label text-secondary small">Código CVC</label>
                                    <input type="password" maxlength="4" class="form-control bg-dark border-secondary text-white rounded-0 py-2" placeholder="•••" required />
                                </div>
                            </div>
                        </div>

                        <div id="wompi-panel-PSE" class="wompi-panel d-none">
                            <div class="mb-3">
                                <label class="form-label text-secondary small">Selecciona tu Banco (Colombia)</label>
                                <select class="form-select bg-dark border-secondary text-white rounded-0 py-2">
                                    <option value="bancolombia">Bancolombia</option>
                                    <option value="davivienda">Banco Davivienda</option>
                                    <option value="banco_bogota">Banco de Bogotá</option>
                                    <option value="bbva">BBVA Colombia</option>
                                    <option value="lulo">Lulo Bank</option>
                                    <option value="nequi_pse">Nequi (vía PSE)</option>
                                    <option value="rappipay">RappiPay</option>
                                    <option value="scotiabank">Scotiabank Colpatria</option>
                                </select>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <label class="form-label text-secondary small">Tipo de Persona</label>
                                    <select class="form-select bg-dark border-secondary text-white rounded-0 py-2">
                                        <option value="0">Natural</option>
                                        <option value="1">Jurídica</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label text-secondary small">Documento Identidad</label>
                                    <input type="text" class="form-control bg-dark border-secondary text-white rounded-0 py-2" placeholder="N° Cédula o NIT" />
                                </div>
                            </div>
                        </div>

                        <div id="wompi-panel-NEQUI" class="wompi-panel d-none text-center py-2">
                            <i class="fas fa-mobile-alt fa-3x mb-3" style="color: #ff007f;"></i>
                            <p class="text-white small mb-2">Ingresa tu número registrado en <strong>Nequi</strong></p>
                            <input type="tel" class="form-control bg-dark border-secondary text-white rounded-0 text-center py-2 mx-auto" style="max-width: 280px;" placeholder="300 123 4567" />
                            <small class="text-secondary d-block mt-2">Recibirás una notificación push en tu app Nequi para autorizar el débito.</small>
                        </div>

                        <div id="wompi-panel-BANCOLOMBIA" class="wompi-panel d-none text-center py-2">
                            <i class="fas fa-university fa-3x text-success mb-3"></i>
                            <p class="text-white small mb-2">Transferencia directa con <strong>Botón de Pago Bancolombia / QR Clic</strong></p>
                            <small class="text-secondary d-block">Serás serás redirigido a la sucursal virtual de Bancolombia para confirmar la transacción.</small>
                        </div>
                    </div>

                    <button type="submit" id="btnPagar" class="btn btn-warning w-100 py-3 fw-bold rounded-0 text-dark mt-3" style="letter-spacing: 2px; background: linear-gradient(135deg, #d4af37, #f0c940); border: none;">
                        <i class="fas fa-lock me-2"></i> PROCESAR PAGO CON WOMPI
                    </button>
                    <div id="loadingSpinner" class="text-center mt-3 d-none">
                        <div class="spinner-border text-warning" role="status">
                            <span class="visually-hidden">Procesando...</span>
                        </div>
                        <p class="text-secondary small mt-2">Conectando de forma segura con la pasarela de pagos Wompi Colombia...</p>
                    </div>
                </form>
            </div>

            <!-- Resumen Right Sidebar -->
            <div class="col-lg-5">
                <div class="card border-0 rounded-0 p-4 sticky-top" style="background-color: #0c0c0c; border: 1px solid #1a1a1a !important; top: 100px;">
                    <h4 class="fw-bold mb-4 text-white" style="font-family: 'Playfair Display', serif;">TU ORDEN</h4>
                    
                    @if (cart != null)
                    {
                        <div class="mb-4" style="max-height: 250px; overflow-y: auto;">
                            @foreach(var item in cart.Detalles)
                            {
                                <div class="d-flex align-items-center mb-3">
                                    <div style="width: 50px; height: 60px; background: #222 url('@(string.IsNullOrEmpty(item.ImagenUrl) ? "" : item.ImagenUrl)') center/cover;"></div>
                                    <div class="ms-3 flex-grow-1">
                                        <div class="text-white small fw-bold">@item.NombreProducto</div>
                                        <div class="text-secondary" style="font-size: 0.75rem;">Cant: @item.Cantidad x $@string.Format("{0:N0}", item.PrecioUnitario)</div>
                                    </div>
                                </div>
                            }
                        </div>
                        
                        <hr style="border-color: #333;">
                        
                        <div class="d-flex justify-content-between mb-2 text-secondary small">
                            <span>Subtotal Neto</span>
                            <span>$@(string.Format("{0:N0}", cart.Total))</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 text-secondary small">
                            <span>IVA (19%)</span>
                            <span>$@(string.Format("{0:N0}", iva))</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4 text-secondary small">
                            <span>Envío Domicilio Seguro</span>
                            <span class="@(envio == 0 ? "text-success fw-bold" : "")">@(envio == 0 ? "GRATIS" : "$" + string.Format("{0:N0}", envio))</span>
                        </div>
                        
                        <div class="d-flex justify-content-between text-white border-top pt-3 mt-2" style="border-color: #333 !important;">
                            <span class="h5 fw-bold">TOTAL GASTO</span>
                            <span class="h5 fw-bold" style="color: var(--gold, #d4af37);">$@(string.Format("{0:N0}", totalFinal))</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Set un UUID para prevenir recargas o doble clic si no existiera
        if (!document.getElementById("IdempotencyKey").value) {
            document.getElementById("IdempotencyKey").value = crypto.randomUUID();
        }

        function switchWompiMethod(method) {
            // Ocultar todos los paneles
            document.querySelectorAll('.wompi-panel').forEach(el => el.classList.add('d-none'));
            
            // Restablecer bordes de los selectores
            document.querySelectorAll('#wompiPaymentSelector label').forEach(lbl => {
                lbl.style.border = '1px solid #333';
            });

            // Mostrar el panel activo y resaltar selector
            const activePanel = document.getElementById('wompi-panel-' + method);
            if (activePanel) activePanel.classList.remove('d-none');

            const activeLbl = document.getElementById('lbl-' + method.toLowerCase());
            if (activeLbl) activeLbl.style.border = '2px solid var(--gold, #d4af37)';
        }

        document.getElementById("checkoutForm").addEventListener("submit", function(e) {
            document.getElementById("btnPagar").classList.add("d-none");
            document.getElementById("loadingSpinner").classList.remove("d-none");
        });
    </script>
}
