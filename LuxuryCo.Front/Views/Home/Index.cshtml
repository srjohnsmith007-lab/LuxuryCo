    </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     CTA BANNER
     ═══════════════════════════════════════════════════════ -->
<section class="py-5" style="background: linear-gradient(135deg, #0a0a0a 0%, #1a1510 50%, #0a0a0a 100%); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);">
    <div class="container text-center py-4" data-reveal="up">
        <p style="font-size: 0.7rem; letter-spacing: 4px; text-transform: uppercase; color: var(--gold); margin-bottom: 1rem;">Únete a la Exclusividad</p>
        <h2 style="font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2.4rem); letter-spacing: 3px; margin-bottom: 1rem;">SUSCRÍBETE PARA LANZAMIENTOS</h2>
        <p style="color: var(--text-muted); max-width: 480px; margin: 0 auto 2rem; font-size: 0.88rem;">Acceso anticipado a nuevas colecciones, ofertas privadas y estilo personalizado.</p>
        <form class="d-flex justify-content-center gap-2" style="max-width: 440px; margin: 0 auto;">
            <input type="email" class="input-luxury flex-grow-1" placeholder="Tu correo electrónico" required style="flex: 1;" />
            <button type="submit" class="btn-gold-luxury" style="padding: 14px 1.8rem;">UNIRME</button>
        </form>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     SECCIÓN BOUTIQUE — iPhone Mockup + Mapa Provenza
     ═══════════════════════════════════════════════════════ -->
