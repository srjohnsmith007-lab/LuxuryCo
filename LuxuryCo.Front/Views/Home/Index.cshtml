@{
    ViewData["Title"] = "Inicio";
}

<!-- Hero Section -->
<div class="hero-section position-relative" style="height: calc(100vh - 80px); background-image: url('https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=2670&auto=format&fit=crop'); background-size: cover; background-position: center top;">
    <!-- Capa de Partículas Doradas -->
    <div class="hero-canvas" id="capa-particulas" style="position:absolute; z-index:1;"></div>
    
    <!-- Subtle Gradient Overlay for Text Readability -->
    <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(to bottom, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.6) 100%);"></div>
    
    <div class="position-absolute w-100 h-100 d-flex flex-column align-items-center justify-content-center text-center px-3" style="z-index: 10;">
        <h1 class="text-white mb-3 d-flex flex-column align-items-center w-100" style="font-family: 'Playfair Display', serif; font-size: 4rem; letter-spacing: 4px; text-transform: uppercase; line-height: 1.2;">
            <span style="font-size: 2.5rem; letter-spacing: 2px; margin-bottom: 10px;">LuxuryCo es</span>
            <div class="animated-words-container text-gold" style="height: 1.2em; overflow: hidden; position: relative; width: 100vw; max-width: 100%;">
                <span class="animated-word active">Elegancia</span>
                <span class="animated-word">Exclusividad</span>
                <span class="animated-word">Sofisticación</span>
                <span class="animated-word">Vanguardia</span>
            </div>
        </h1>
        <p class="text-white-50 mb-5" style="letter-spacing: 2px; text-transform: uppercase; font-size: 0.9rem; max-width: 600px;">Descubre la elegancia redefinida. Piezas exclusivas diseñadas para inspirar y cautivar.</p>
        <a href="/Shop/Category/Todos" class="btn btn-gold" style="width: auto; padding: 1rem 3rem;">Explorar Ahora</a>
    </div>
</div>

<!-- Featured Categories Section -->
<div class="container-fluid py-5" style="background-color: var(--color-black);">
    <div class="row g-1">
        <!-- Category 1 -->
        <div class="col-md-4 position-relative overflow-hidden group">
            <div style="height: 600px; background-image: url('https://images.unsplash.com/photo-1549439602-43ebca2327af?q=80&w=2670&auto=format&fit=crop'); background-size: cover; background-position: center; transition: transform 0.7s;" class="hover-zoom"></div>
            <div class="position-absolute bottom-0 start-0 w-100 p-4 text-center" style="background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);">
                <h3 class="text-white mb-1" style="font-family: 'Playfair Display', serif; letter-spacing: 2px;">Mujer</h3>
                <a asp-controller="Shop" asp-action="Category" asp-route-id="Mujer" class="text-white text-decoration-none" style="font-size: 0.8rem; letter-spacing: 1px; border-bottom: 1px solid var(--color-gold); padding-bottom: 2px;">DESCUBRIR</a>
            </div>
        </div>
        
        <!-- Category 2 -->
        <div class="col-md-4 position-relative overflow-hidden group">
            <div style="height: 600px; background-image: url('https://images.unsplash.com/photo-1516257984-b1b4d707412e?q=80&w=2574&auto=format&fit=crop'); background-size: cover; background-position: center; transition: transform 0.7s;" class="hover-zoom"></div>
            <div class="position-absolute bottom-0 start-0 w-100 p-4 text-center" style="background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);">
                <h3 class="text-white mb-1" style="font-family: 'Playfair Display', serif; letter-spacing: 2px;">Hombre</h3>
                <a asp-controller="Shop" asp-action="Category" asp-route-id="Hombre" class="text-white text-decoration-none" style="font-size: 0.8rem; letter-spacing: 1px; border-bottom: 1px solid var(--color-gold); padding-bottom: 2px;">DESCUBRIR</a>
            </div>
        </div>
        
        <!-- Category 3 -->
        <div class="col-md-4 position-relative overflow-hidden group">
            <div style="height: 600px; background-image: url('https://images.unsplash.com/photo-1560343090-f0409e92791a?q=80&w=2648&auto=format&fit=crop'); background-size: cover; background-position: center; transition: transform 0.7s;" class="hover-zoom"></div>
            <div class="position-absolute bottom-0 start-0 w-100 p-4 text-center" style="background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);">
                <h3 class="text-white mb-1" style="font-family: 'Playfair Display', serif; letter-spacing: 2px;">Accesorios</h3>
                <a asp-controller="Shop" asp-action="Category" asp-route-id="Accesorios" class="text-white text-decoration-none" style="font-size: 0.8rem; letter-spacing: 1px; border-bottom: 1px solid var(--color-gold); padding-bottom: 2px;">DESCUBRIR</a>
            </div>
        </div>
    </div>
</div>

<!-- Floating Recommendations Widget (Bottom Left) -->
<div id="floating-recs-widget" class="floating-widget">
    <div class="widget-icon">
        <i class="fas fa-gem text-gold"></i>
    </div>
    <div class="widget-text">Recomendaciones del día</div>
</div>

<!-- Recommendations Overlay -->
<div id="recs-overlay" class="recs-overlay d-none">
    <button id="close-recs" class="close-btn"><i class="fas fa-times"></i></button>
    <div class="stage">
        <h3 class="recs-title">Recomendaciones del día</h3>
        <div class="stack-wrapper" id="recs-stack"></div>
        <div class="hint">Haz clic en la carta frontal para ver la siguiente</div>
    </div>
</div>

<style>
    .hover-zoom:hover {
        transform: scale(1.05);
    }
    
    /* Animated Words CSS */
    .animated-words-container {
        display: flex;
        justify-content: center;
    }
    
    .animated-word {
        position: absolute;
        opacity: 0;
        transform: translateY(100%);
        transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        width: 100%;
        text-align: center;
        font-weight: 600;
    }
    
    .animated-word.active {
        opacity: 1;
        transform: translateY(0);
    }
    
    .animated-word.out {
        opacity: 0;
        transform: translateY(-100%);
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const words = document.querySelectorAll(".animated-word");
            let currentIndex = 0;
            
            if(words.length === 0) return;

            setInterval(() => {
                // Current word goes up and out
                words[currentIndex].classList.remove("active");
                words[currentIndex].classList.add("out");
                
                // Next word comes in from bottom
                currentIndex = (currentIndex + 1) % words.length;
                
                // Reset the new current word's position instantly before animating it in
                words[currentIndex].classList.remove("out");
                
                // Small delay to allow CSS to apply the reset before adding active class
                setTimeout(() => {
                    words[currentIndex].classList.add("active");
                }, 50);
                
            }, 2500); // Change word every 2.5 seconds
            
            // Lógica del Widget de Recomendaciones
            const widget = document.getElementById('floating-recs-widget');
            const overlay = document.getElementById('recs-overlay');
            const closeBtn = document.getElementById('close-recs');
            const stack = document.getElementById('recs-stack');
            
            let products = [];
            let order = [];
            
            widget.addEventListener('click', () => {
                overlay.classList.remove('d-none');
                if (products.length === 0) {
                    fetchProducts();
                }
            });
            
            closeBtn.addEventListener('click', () => {
                overlay.classList.add('d-none');
            });
            
            async function fetchProducts() {
                try {
                    const res = await fetch('https://luxuryco.onrender.com/api/producto');
                    if (res.ok) {
                        const data = await res.json();
                        // Tomar 5 aleatorios
                        products = data.sort(() => 0.5 - Math.random()).slice(0, 5);
                        order = Array.from({length: products.length}, (_, i) => i);
                        renderStack();
                    }
                } catch(e) {
                    console.error('Error cargando recomendaciones', e);
                }
            }
            
            function renderStack() {
                stack.innerHTML = '';
                order.forEach((cardIndex, depth) => {
                    const p = products[cardIndex];
                    const el = document.createElement('div');
                    el.className = 'recs-card';
                    
                    const offsetX = depth * 10;
                    const offsetY = depth * -6;
                    const rotate = depth * 4.5;
                    const scale = 1 - depth * 0.035;

                    el.style.transform = `translate(${offsetX}px, ${offsetY}px) rotate(${rotate}deg) scale(${scale})`;
                    el.style.zIndex = 100 - depth;
                    el.style.boxShadow = depth === 0
                        ? '0 14px 34px rgba(0,0,0,0.5), 0 3px 10px rgba(0,0,0,0.3)'
                        : '0 6px 16px rgba(0,0,0,0.3)';

                    const imageUrl = p.imagenUrl ? p.imagenUrl : 'https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=2670&auto=format&fit=crop';
                    
                    el.innerHTML = `
                        <div class="recs-card-image" style="background-image: url('${imageUrl}'); background-size: cover; background-position: center;">
                            <div class="recs-card-overlay"></div>
                        </div>
                        <div class="recs-card-label">
                            ${p.nombre}
                            <span class="recs-card-sub">$${p.precio.toLocaleString()} USD</span>
                        </div>
                    `;

                    if (depth === 0) {
                        el.addEventListener('click', (e) => {
                            if (e.target.tagName.toLowerCase() !== 'a') {
                                cycle();
                            }
                        });
                        
                        const link = document.createElement('a');
                        link.href = `/Shop/Product/${p.id_producto}`;
                        link.className = 'recs-btn-link';
                        link.innerHTML = 'Ir al producto';
                        el.appendChild(link);
                    }

                    stack.appendChild(el);
                });
            }

            function cycle() {
                if(order.length === 0) return;
                const front = stack.querySelector('.recs-card');
                front.style.transition = 'transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease';
                front.style.transform += ' translate(120px, 40px) rotate(22deg)';
                front.style.opacity = '0';

                setTimeout(() => {
                    order.push(order.shift());
                    renderStack();
                }, 230);
            }
        });
    </script>
}
