                                    <i class="fas fa-shopping-bag" style="color: var(--gold); font-size: 0.9rem;"></i>
                                </div>
                                <div class="app-hero-img">
                                    <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=400&auto=format&fit=crop" alt="LuxuryCo App" style="width:100%; height:100%; object-fit:cover; object-position: center top;">
