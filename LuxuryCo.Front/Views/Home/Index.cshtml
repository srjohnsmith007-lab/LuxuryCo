@{
    ViewData["Title"] = "Inicio";
}

<!-- ═══════════════════════════════════════════════════════
     HERO — Full-screen with GSAP parallax + animated words
     ═══════════════════════════════════════════════════════ -->
<section class="hero-section position-relative" style="height: 100vh; overflow: hidden;">
    <div class="hero-bg" data-parallax="0.4" style="position: absolute; inset: -60px; background-image: url('https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=2670&auto=format&fit=crop'); background-size: cover; background-position: center top;"></div>
    <div class="hero-canvas" id="capa-particulas" style="position:absolute; z-index:1;"></div>
    <div style="position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.55) 100%);"></div>

    <div class="position-absolute w-100 h-100 d-flex flex-column align-items-center justify-content-center text-center px-3" style="z-index: 10;">
        <div data-reveal="up" data-reveal-delay="0.1">
            <p style="font-family: var(--font-ui); font-size: 0.75rem; letter-spacing: 6px; text-transform: uppercase; color: var(--gold); margin-bottom: 1.2rem;">Nueva Colección 2026</p>
        </div>
        <h1 data-reveal="up" data-reveal-delay="0.2" class="text-white mb-3 d-flex flex-column align-items-center w-100" style="font-family: var(--font-display); font-size: clamp(2.2rem, 5vw, 4.2rem); letter-spacing: 4px; text-transform: uppercase; line-height: 1.15;">
            <span style="font-size: clamp(1.2rem, 2.5vw, 2rem); letter-spacing: 2px; margin-bottom: 8px; font-weight: 300;">LuxuryCo es</span>
            <div class="animated-words-container" style="height: 1.2em; overflow: hidden; position: relative; width: 100vw; max-width: 100%;">
                <span class="animated-word active">Elegancia</span>
                <span class="animated-word">Exclusividad</span>
                <span class="animated-word">Sofisticación</span>
                <span class="animated-word">Vanguardia</span>
            </div>
        </h1>
        <p data-reveal="up" data-reveal-delay="0.35" class="text-white-50 mb-5" style="letter-spacing: 2px; text-transform: uppercase; font-size: 0.85rem; max-width: 540px;">Descubre la elegancia redefinida. Piezas exclusivas diseñadas para inspirar y cautivar.</p>
        <div data-reveal="up" data-reveal-delay="0.5">
            <a href="/Shop/Category/Todos" class="btn-gold-luxury">EXPLORAR AHORA <i class="fas fa-arrow-right" style="font-size: 0.7rem;"></i></a>
        </div>
    </div>

    <div style="position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%); z-index: 10; text-align: center;">
        <div data-reveal="up" data-reveal-delay="0.8" style="animation: bounce-down 2s ease-in-out infinite;">
            <i class="fas fa-chevron-down" style="color: var(--gold); font-size: 1.2rem; opacity: 0.6;"></i>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     PRODUCTOS DESTACADOS — Swiper Carousel
     ═══════════════════════════════════════════════════════ -->
<section class="py-5 mt-4" style="background: var(--black);">
    <div class="container-fluid px-4 px-lg-5">
        <div class="section-heading" data-reveal="up">
            <span class="section-label">Lo Más Deseado</span>
            <h2>Productos Destacados</h2>
            <p>Selección curada por nuestro equipo de estilistas</p>
        </div>

        <div class="position-relative" data-reveal="up" data-reveal-delay="0.2">
            <div class="swiper luxury-swiper" id="featured-swiper">
                <div class="swiper-wrapper" id="featured-wrapper">
                    <!-- Skeleton loading while API responds -->
                    <div class="swiper-slide"><div class="product-card"><div class="skeleton skeleton-img"></div><div class="card-body"><div class="skeleton skeleton-title"></div><div class="skeleton skeleton-text" style="width:40%"></div></div></div></div>
                    <div class="swiper-slide"><div class="product-card"><div class="skeleton skeleton-img"></div><div class="card-body"><div class="skeleton skeleton-title"></div><div class="skeleton skeleton-text" style="width:40%"></div></div></div></div>
                    <div class="swiper-slide"><div class="product-card"><div class="skeleton skeleton-img"></div><div class="card-body"><div class="skeleton skeleton-title"></div><div class="skeleton skeleton-text" style="width:40%"></div></div></div></div>
                    <div class="swiper-slide"><div class="product-card"><div class="skeleton skeleton-img"></div><div class="card-body"><div class="skeleton skeleton-title"></div><div class="skeleton skeleton-text" style="width:40%"></div></div></div></div>
                </div>
                <div class="swiper-pagination"></div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     EMBAJADORES — Testimonials with 3D Carousel
     ═══════════════════════════════════════════════════════ -->
<section class="py-5" style="background: var(--black-soft);">
    <div class="container-fluid">
        <div class="section-heading" data-reveal="up">
            <span class="section-label">Nuestros Embajadores</span>
            <h2>La Elegancia Personificada</h2>
            <p>Quienes representan la esencia de nuestras marcas</p>
        </div>
    </div>

    <div class="testimonial-container mx-auto" data-reveal="scale">
        <div class="testimonial-grid">
            <div class="image-container" id="imageContainer"></div>
            <div class="testimonial-content">
                <div id="textBlock">
                    <h3 class="name" id="name"></h3>
                    <p class="designation" id="designation"></p>
                    <p class="quote" id="quote"></p>
                </div>
                <div class="arrow-buttons">
                    <button class="arrow-button" id="prevBtn" aria-label="Anterior">
                        <svg viewBox="0 0 512 512"><path d="M257.5 445c-8.8 0-17.5-3.4-24-10.1L45.9 246.4c-6.4-6.7-9.9-15.5-9.9-24.8 0-9.3 3.5-18.1 9.9-24.8L233.5 12.3c13.3-13.9 35.4-14.4 49.3-1.1 13.9 13.3 14.4 35.4 1.1 49.3L128.7 221.6l155.2 161.1c13.3 13.9 12.8 36-1.1 49.3-6.8 6.5-15.5 9.7-24.3 9.7z"/></svg>
                    </button>
                    <button class="arrow-button" id="nextBtn" aria-label="Siguiente">
                        <svg viewBox="0 0 512 512"><path d="M255.5 445c-8.8 0-17.5-3.2-24.3-9.7-13.9-13.3-14.4-35.4-1.1-49.3l155.2-161.1L230.1 63.8c-13.3-13.9-12.8-36 1.1-49.3 13.9-13.3 36-12.8 49.3 1.1l187.6 195.6c6.4 6.7 9.9 15.5 9.9 24.8 0 9.3-3.5 18.1-9.9 24.8L279.5 434.9c-6.5 6.7-15.2 10.1-24 10.1z"/></svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     MARCAS — Swiper Logo Carousel
     ═══════════════════════════════════════════════════════ -->
<section class="py-5" style="background: var(--black);">
    <div class="container-fluid">
        <div class="section-heading" data-reveal="up">
            <span class="section-label">Nuestras Alianzas</span>
            <h2>Marcas Exclusivas</h2>
            <p>Colecciones de los diseñadores más prestigiosos del mundo</p>
        </div>

        <div class="swiper luxury-swiper" data-reveal="up" data-reveal-delay="0.2" id="brands-swiper">
            <div class="swiper-wrapper" id="brands-wrapper"></div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     CTA BANNER
     ═══════════════════════════════════════════════════════ -->
<section class="py-5" style="background: linear-gradient(135deg, #0a0a0a 0%, #1a1510 50%, #0a0a0a 100%); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);">
    <div class="container text-center py-4" data-reveal="up">
        <p style="font-size: 0.7rem; letter-spacing: 4px; text-transform: uppercase; color: var(--gold); margin-bottom: 1rem;">Únete a la Exclusividad</p>
        <h2 style="font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2.4rem); letter-spacing: 3px; margin-bottom: 1rem;">SUSCRÍBETE PARA LANZAMIENTOS</h2>
        <p style="color: var(--text-muted); max-width: 480px; margin: 0 auto 2rem; font-size: 0.88rem;">Acceso anticipado a nuevas colecciones, ofertas privadas y estilo personalizado.</p>
        <form class="d-flex justify-content-center gap-2" style="max-width: 440px; margin: 0 auto;">
            <input type="email" class="input-luxury flex-grow-1" placeholder="Tu correo electrónico" required style="flex: 1;" />
            <button type="submit" class="btn-gold-luxury" style="padding: 14px 1.8rem;">UNIRME</button>
        </form>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     SECCIÓN UBICACIÓN (MAPA PROVENZA)
     ═══════════════════════════════════════════════════════ -->
<section style="background-color: var(--black); padding: 5rem 0; border-top: 1px solid var(--border);" class="position-relative">
    <div class="container text-center mb-5" data-reveal="up">
        <p style="font-size: 0.7rem; letter-spacing: 4px; text-transform: uppercase; color: var(--gold); margin-bottom: 0.8rem;">Encuéntranos en Medellín</p>
        <h2 style="font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.5rem); letter-spacing: 3px; color: var(--text);">NUESTRA BOUTIQUE EN PROVENZA</h2>
        <div style="width: 50px; height: 1px; background: var(--gold); margin: 1.5rem auto;"></div>
        <p style="color: var(--text-muted); max-width: 600px; margin: 0 auto; font-size: 0.9rem;">
            El epicentro del lujo y la moda en Colombia. Visítanos en nuestra sede principal para una experiencia de 'Personal Shopper' exclusiva y conoce nuestras colecciones en vivo.
        </p>
    </div>

    <div class="container" data-reveal="up" data-reveal-delay="200">
        <div class="row gx-0 align-items-center" style="border: 1px solid var(--border); border-radius: 12px; overflow: hidden; background: var(--black-soft); box-shadow: 0 10px 40px rgba(0,0,0,0.5);">
            <div class="col-lg-6 position-relative" style="height: 400px; border-right: 1px solid var(--border);">
                <!-- Filtro para mapa oscuro (luxury dark map) -->
                <div style="width: 100%; height: 100%; filter: grayscale(100%) invert(92%) contrast(85%) opacity(0.85);">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15866.505537554522!2d-75.5714394464879!3d6.208149866173007!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e442828b6d4e8c1%3A0x6334f5ab3c155d31!2sProvenza%2C%20El%20Poblado%2C%20Medell%C3%ADn%2C%20Antioquia!5e0!3m2!1ses!2sco!4v1700000000000!5m2!1ses!2sco" 
                        width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>
            <div class="col-lg-6 p-5">
                <h4 style="font-family: var(--font-display); letter-spacing: 2px; font-size: 1.2rem; margin-bottom: 2rem; color: var(--gold);">ATENCIÓN VIP</h4>
                
                <div class="mb-4 d-flex align-items-start gap-3">
                    <div style="width: 32px; height: 32px; border-radius: 50%; background: rgba(212, 175, 55, 0.1); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <i class="fas fa-map-marker-alt" style="color: var(--gold); font-size: 0.9rem;"></i>
                    </div>
                    <div>
                        <strong style="color: var(--text); font-size: 0.85rem; letter-spacing: 2px; text-transform: uppercase;">DIRECCIÓN</strong><br>
                        <span style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.6;">Zona Provenza, El Poblado<br>Medellín, Antioquia</span>
                    </div>
                </div>
                
                <div class="mb-4 d-flex align-items-start gap-3">
                    <div style="width: 32px; height: 32px; border-radius: 50%; background: rgba(212, 175, 55, 0.1); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <i class="far fa-clock" style="color: var(--gold); font-size: 0.9rem;"></i>
                    </div>
                    <div>
                        <strong style="color: var(--text); font-size: 0.85rem; letter-spacing: 2px; text-transform: uppercase;">HORARIOS</strong><br>
                        <span style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.6;">Lunes - Sábado: 10:00 AM - 8:00 PM<br>Domingos: Exclusivo con cita previa</span>
                    </div>
                </div>
                
                <div class="d-flex align-items-start gap-3">
                    <div style="width: 32px; height: 32px; border-radius: 50%; background: rgba(212, 175, 55, 0.1); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <i class="fas fa-concierge-bell" style="color: var(--gold); font-size: 0.9rem;"></i>
                    </div>
                    <div>
                        <strong style="color: var(--text); font-size: 0.85rem; letter-spacing: 2px; text-transform: uppercase;">RESERVAS PRIVADAS</strong><br>
                        <span style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.6;">Habla con nuestro Chatbot AI para agendar una prueba privada con un Personal Shopper.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     STYLES (page-specific)
     ═══════════════════════════════════════════════════════ -->
<style>
    .animated-words-container { display: flex; justify-content: center; }
    .animated-word {
        position: absolute; opacity: 0; transform: translateY(100%);
        transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        width: 100%; text-align: center; font-weight: 600; color: var(--gold);
    }
    .animated-word.active { opacity: 1; transform: translateY(0); }
    .animated-word.out { opacity: 0; transform: translateY(-100%); }

    .recs-card-image { position: absolute; inset: 0; z-index: 1; overflow: hidden; background: #0a0a0a; }
    .recs-card-image img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }

    .brands-slide {
        display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
        height: 220px; position: relative; overflow: hidden; border-radius: 8px;
        cursor: pointer; border: 1px solid var(--border);
        transition: transform 0.4s ease, border-color 0.4s ease;
    }
    .brands-slide:hover { transform: translateY(-6px); border-color: var(--gold); }
    .brands-slide .brand-bg {
        position: absolute; inset: 0;
        background-size: cover; background-position: center top;
        filter: brightness(0.5) grayscale(30%);
        transition: filter 0.4s ease, transform 0.4s ease;
    }
    .brands-slide:hover .brand-bg { filter: brightness(0.65) grayscale(0%); transform: scale(1.05); }
    .brands-slide .brand-info {
        position: relative; z-index: 2; padding: 1rem 1.2rem;
        width: 100%; background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 100%);
    }
    .brands-slide .brand-name {
        font-family: var(--font-display); font-size: 1.1rem; letter-spacing: 3px;
        text-transform: uppercase; color: #fff; font-weight: 600;
    }
    .brands-slide .brand-sub {
        font-size: 0.65rem; letter-spacing: 2px; color: var(--gold); text-transform: uppercase; margin-top: 2px;
    }

    @@keyframes bounce-down {
        0%, 100% { transform: translateX(-50%) translateY(0); }
        50% { transform: translateX(-50%) translateY(8px); }
    }
</style>

<!-- ═══════════════════════════════════════════════════════
     SCRIPTS
     ═══════════════════════════════════════════════════════ -->
@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function() {

    // ─── Animated Words ───
    const words = document.querySelectorAll(".animated-word");
    let wordIndex = 0;
    if (words.length > 0) {
        setInterval(() => {
            words[wordIndex].classList.remove("active");
            words[wordIndex].classList.add("out");
            wordIndex = (wordIndex + 1) % words.length;
            words[wordIndex].classList.remove("out");
            setTimeout(() => words[wordIndex].classList.add("active"), 50);
        }, 2800);
    }

    // ─── Featured Products Swiper ───
    if (typeof Swiper !== 'undefined') {
        new Swiper('#featured-swiper', {
            slidesPerView: 1.3,
            centeredSlides: true,
            spaceBetween: 20,
            loop: true,
            autoplay: { delay: 4000, disableOnInteraction: false },
            pagination: { el: '.swiper-pagination', clickable: true },
            breakpoints: {
                576:  { slidesPerView: 2,   spaceBetween: 24 },
                768:  { slidesPerView: 2.5, spaceBetween: 28 },
                1024: { slidesPerView: 3.2, spaceBetween: 32 },
                1280: { slidesPerView: 4,   spaceBetween: 28 }
            }
        });
    }

    // ─── Load Featured Products from API (Backend) ───
    const backendUrl = document.querySelector('meta[name="api-base-url"]')?.content || 'https://luxuryco.onrender.com/api';
    fetch(`${backendUrl}/producto`)
        .then(r => r.ok ? r.json() : [])
        .then(products => {
            const wrapper = document.getElementById('featured-wrapper');
            if (!wrapper || !products.length) return;
            const featured = products.filter(p => p.activo && p.stock > 0).slice(0, 12);
            if (!featured.length) return;
            wrapper.innerHTML = featured.map(p => {
                const img = p.imagenPrincipalUrl || 'https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=600&auto=format&fit=crop';
                return `
                <div class="swiper-slide">
                    <a href="/Shop/Product/${p.idProducto}" class="product-card" style="text-decoration:none; display:block;">
                        <div class="card-img-wrap">
                            <img src="${img}" alt="${p.nombre}" loading="lazy">
                            <div class="card-img-overlay">
                                <span class="badge-luxury badge-gold">Ver Producto</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="card-brand">${p.marcaNombre || 'LuxuryCo'}</div>
                            <div class="card-name">${p.nombre}</div>
                            <div class="card-price">$${Number(p.precio).toLocaleString()} COP</div>
                        </div>
                    </a>
                </div>`;
            }).join('');

            // Re-inicializar Swiper con productos reales
            if (typeof Swiper !== 'undefined') {
                new Swiper('#featured-swiper', {
                    slidesPerView: 1.3,
                    centeredSlides: true,
                    spaceBetween: 20,
                    loop: featured.length > 3,
                    autoplay: { delay: 4000, disableOnInteraction: false },
                    pagination: { el: '.swiper-pagination', clickable: true },
                    breakpoints: {
                        576:  { slidesPerView: 2,   spaceBetween: 24 },
                        768:  { slidesPerView: 2.5, spaceBetween: 28 },
                        1024: { slidesPerView: 3.2, spaceBetween: 32 },
                        1280: { slidesPerView: 4,   spaceBetween: 28 }
                    }
                });
            }
        })
        .catch(() => {});

    // ─── Brands Swiper ───
    const brands = [
        { name: 'GUCCI',         sub: 'Italian Luxury · Since 1921',     img: 'https://images.unsplash.com/photo-1548036328-c9fa89d128fa?q=80&w=600&auto=format&fit=crop' },
        { name: 'PRADA',         sub: 'Milan Fashion · Since 1913',      img: '/images/prada.jpg' },
        { name: 'LOUIS VUITTON', sub: 'Paris Heritage · Since 1854',     img: '/images/LOUIS VUITTON.webp' },
        { name: 'ROLEX',         sub: 'Swiss Mastery · Since 1905',      img: 'https://images.unsplash.com/photo-1523170335258-f5ed11844a49?q=80&w=600&auto=format&fit=crop' },
        { name: 'CARTIER',       sub: 'Fine Jewelry · Since 1847',       img: 'https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?q=80&w=600&auto=format&fit=crop' },
        { name: 'DIOR',          sub: 'French Elegance · Since 1946',    img: '/images/dior.webp' },
        { name: 'CHANEL',        sub: 'Timeless Parisian · Since 1910',  img: '/images/chanel.jpg' },
        { name: 'BALENCIAGA',    sub: 'Avant-Garde · Since 1919',        img: '/images/balensiaga.avif' },
        { name: 'HERMÈS',        sub: 'Artisan Leather · Since 1837',    img: '/images/hermes.webp' },
        { name: 'YSL',           sub: 'Yves Saint Laurent · Since 1961', img: '/images/ysl.jpg' },
    ];

    const brandsWrapper = document.getElementById('brands-wrapper');
    if (brandsWrapper && typeof Swiper !== 'undefined') {
        brandsWrapper.innerHTML = brands.map(b => `
            <div class="swiper-slide brands-slide">
                <div class="brand-bg" style="background-image: url('${b.img}')"></div>
                <div class="brand-info">
                    <div class="brand-name">${b.name}</div>
                    <div class="brand-sub">${b.sub}</div>
                </div>
            </div>
        `).join('');

        new Swiper('#brands-swiper', {
            slidesPerView: 1.5,
            spaceBetween: 16,
            loop: true,
            autoplay: { delay: 2800, disableOnInteraction: false },
            speed: 800,
            breakpoints: {
                576:  { slidesPerView: 2.2, spaceBetween: 20 },
                768:  { slidesPerView: 3.2, spaceBetween: 24 },
                1024: { slidesPerView: 4.2, spaceBetween: 28 },
                1280: { slidesPerView: 5,   spaceBetween: 28 }
            }
        });
    }

    // ─── Testimonials Logic ───
    const testimonials = [
        { quote: "La esencia de LuxuryCo radica en su capacidad de transformar la moda en arte puro. Vestir estas marcas es llevar una obra maestra en cada paso.", name: "Gigi Hadid", designation: "Embajadora de Alta Costura", src: "https://images.unsplash.com/photo-1469334031218-e382a71b716b?q=80&w=1440&auto=format&fit=crop" },
        { quote: "Un estilo que trasciende las tendencias. Para el hombre moderno que valora la sastrería impecable y el diseño vanguardista en cada detalle.", name: "Sean O'Pry", designation: "Ícono de Elegancia Masculina", src: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?q=80&w=1440&auto=format&fit=crop" },
        { quote: "Revolucionando la forma en que entendemos el lujo. Las colecciones curadas por LuxuryCo son simplemente incomparables e inspiradoras.", name: "Bella Hadid", designation: "Modelo de Vanguardia", src: "https://images.unsplash.com/photo-1509631179647-0177331693ae?q=80&w=1440&auto=format&fit=crop" }
    ];

    let tIndex = 0;
    const tTotal = testimonials.length;
    const imgContainer = document.getElementById('imageContainer');
    let tAutoplay = null;

    function calcGap(w) { const mn=400,mx=900,mg=40,xg=70; return w<=mn?mg:w>=mx?xg:mg+(xg-mg)*((w-mn)/(mx-mn)); }

    testimonials.forEach((t, i) => {
        const img = document.createElement('img');
        img.src = t.src; img.alt = t.name; img.className = 'testimonial-image'; img.dataset.index = i;
        imgContainer.appendChild(img);
    });

    function updateTImages() {
        const gap = calcGap(imgContainer.offsetWidth), maxUp = gap * 0.8;
        imgContainer.querySelectorAll('.testimonial-image').forEach((img, i) => {
            const active = i===tIndex, left = (tIndex-1+tTotal)%tTotal===i, right = (tIndex+1)%tTotal===i;
            img.style.zIndex = active?3:left||right?2:1;
            img.style.opacity = active||left||right?1:0;
            img.style.pointerEvents = active||left||right?'auto':'none';
            if (active) img.style.transform = 'translateX(0) translateY(0) scale(1) rotateY(0)';
            else if (left) img.style.transform = `translateX(-${gap}px) translateY(-${maxUp}px) scale(0.85) rotateY(15deg)`;
            else if (right) img.style.transform = `translateX(${gap}px) translateY(-${maxUp}px) scale(0.85) rotateY(-15deg)`;
        });
    }

    function updateTText() {
        const t = testimonials[tIndex];
        document.getElementById('name').textContent = t.name;
        document.getElementById('designation').textContent = t.designation;
        const qEl = document.getElementById('quote');
        qEl.innerHTML = '';
        t.quote.split(' ').forEach((w, i) => {
            const s = document.createElement('span');
            s.textContent = w + '\u00A0';
            s.style.cssText = 'filter:blur(10px); opacity:0; transform:translateY(5px); transition: all 0.35s ease;';
            qEl.appendChild(s);
            setTimeout(() => { s.style.filter='blur(0)'; s.style.opacity='1'; s.style.transform='translateY(0)'; }, 25*i);
        });
    }

    function renderT() { updateTImages(); updateTText(); }
    function resetTAutoplay() { clearInterval(tAutoplay); tAutoplay = setInterval(() => { tIndex=(tIndex+1)%tTotal; renderT(); }, 5500); }

    document.getElementById('nextBtn').addEventListener('click', () => { tIndex=(tIndex+1)%tTotal; renderT(); resetTAutoplay(); });
    document.getElementById('prevBtn').addEventListener('click', () => { tIndex=(tIndex-1+tTotal)%tTotal; renderT(); resetTAutoplay(); });
    window.addEventListener('resize', updateTImages);
    renderT(); resetTAutoplay();
});
</script>
}
