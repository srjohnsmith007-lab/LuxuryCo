@{
    ViewData["Title"] = "Inicio";
}

<!-- ═══════════════════════════════════════════════════════
     HERO — Full-screen with GSAP parallax + animated words
     ═══════════════════════════════════════════════════════ -->
<section class="hero-section position-relative" style="height: 100vh; overflow: hidden;">
    <div class="hero-bg" data-parallax="0.4" style="position: absolute; inset: -60px; background-image: url('https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=2670&auto=format&fit=crop'); background-size: cover; background-position: center top;"></div>
    <div class="hero-canvas" id="capa-particulas" style="position:absolute; z-index:1;"></div>
    <div style="position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.55) 100%);"></div>

    <div class="position-absolute w-100 h-100 d-flex flex-column align-items-center justify-content-center text-center px-3" style="z-index: 10;">
        <div data-reveal="up" data-reveal-delay="0.1">
            <p style="font-family: var(--font-ui); font-size: 0.75rem; letter-spacing: 6px; text-transform: uppercase; color: var(--gold); margin-bottom: 1.2rem;">Nueva Colección 2026</p>
        </div>
        <h1 data-reveal="up" data-reveal-delay="0.2" class="text-white mb-3 d-flex flex-column align-items-center w-100" style="font-family: var(--font-display); font-size: clamp(2.2rem, 5vw, 4.2rem); letter-spacing: 4px; text-transform: uppercase; line-height: 1.15;">
            <span style="font-size: clamp(1.2rem, 2.5vw, 2rem); letter-spacing: 2px; margin-bottom: 8px; font-weight: 300;">LuxuryCo es</span>
            <div class="animated-words-container" style="height: 1.2em; overflow: hidden; position: relative; width: 100vw; max-width: 100%;">
                <span class="animated-word active">Elegancia</span>
                <span class="animated-word">Exclusividad</span>
                <span class="animated-word">Sofisticación</span>
                <span class="animated-word">Vanguardia</span>
            </div>
        </h1>
        <p data-reveal="up" data-reveal-delay="0.35" class="text-white-50 mb-5" style="letter-spacing: 2px; text-transform: uppercase; font-size: 0.85rem; max-width: 540px;">Descubre la elegancia redefinida. Piezas exclusivas diseñadas para inspirar y cautivar.</p>
        <div data-reveal="up" data-reveal-delay="0.5">
            <a href="/Shop/Category/Todos" class="btn-gold-luxury">EXPLORAR AHORA <i class="fas fa-arrow-right" style="font-size: 0.7rem;"></i></a>
        </div>
    </div>

    <div style="position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%); z-index: 10; text-align: center;">
        <div data-reveal="up" data-reveal-delay="0.8" style="animation: bounce-down 2s ease-in-out infinite;">
            <i class="fas fa-chevron-down" style="color: var(--gold); font-size: 1.2rem; opacity: 0.6;"></i>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     PRODUCTOS DESTACADOS — Swiper Carousel
     ═══════════════════════════════════════════════════════ -->
<section class="py-5 mt-4" style="background: var(--black);">
    <div class="container-fluid px-4 px-lg-5">
        <div class="section-heading" data-reveal="up">
            <span class="section-label">Lo Más Deseado</span>
            <h2>Productos Destacados</h2>
            <p>Selección curada por nuestro equipo de estilistas</p>
        </div>

        <div class="position-relative" data-reveal="up" data-reveal-delay="0.2">
            <div class="swiper luxury-swiper" id="featured-swiper">
                <div class="swiper-wrapper" id="featured-wrapper">
                    <!-- Skeleton loading while API responds -->
                    <div class="swiper-slide"><div class="product-card"><div class="skeleton skeleton-img"></div><div class="card-body"><div class="skeleton skeleton-title"></div><div class="skeleton skeleton-text" style="width:40%"></div></div></div></div>
                    <div class="swiper-slide"><div class="product-card"><div class="skeleton skeleton-img"></div><div class="card-body"><div class="skeleton skeleton-title"></div><div class="skeleton skeleton-text" style="width:40%"></div></div></div></div>
                    <div class="swiper-slide"><div class="product-card"><div class="skeleton skeleton-img"></div><div class="card-body"><div class="skeleton skeleton-title"></div><div class="skeleton skeleton-text" style="width:40%"></div></div></div></div>
                    <div class="swiper-slide"><div class="product-card"><div class="skeleton skeleton-img"></div><div class="card-body"><div class="skeleton skeleton-title"></div><div class="skeleton skeleton-text" style="width:40%"></div></div></div></div>
                </div>
                <div class="swiper-pagination"></div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     EMBAJADORES — Testimonials with 3D Carousel
     ═══════════════════════════════════════════════════════ -->
<section class="py-5" style="background: var(--black-soft);">
    <div class="container-fluid">
        <div class="section-heading" data-reveal="up">
            <span class="section-label">Nuestros Embajadores</span>
            <h2>La Elegancia Personificada</h2>
            <p>Quienes representan la esencia de nuestras marcas</p>
        </div>
    </div>

    <div class="testimonial-container mx-auto" data-reveal="scale">
        <div class="testimonial-grid">
            <div class="image-container" id="imageContainer"></div>
            <div class="testimonial-content">
                <div id="textBlock">
                    <h3 class="name" id="name"></h3>
                    <p class="designation" id="designation"></p>
                    <p class="quote" id="quote"></p>
                </div>
                <div class="arrow-buttons">
                    <button class="arrow-button" id="prevBtn" aria-label="Anterior">
                        <svg viewBox="0 0 512 512"><path d="M257.5 445c-8.8 0-17.5-3.4-24-10.1L45.9 246.4c-6.4-6.7-9.9-15.5-9.9-24.8 0-9.3 3.5-18.1 9.9-24.8L233.5 12.3c13.3-13.9 35.4-14.4 49.3-1.1 13.9 13.3 14.4 35.4 1.1 49.3L128.7 221.6l155.2 161.1c13.3 13.9 12.8 36-1.1 49.3-6.8 6.5-15.5 9.7-24.3 9.7z"/></svg>
                    </button>
                    <button class="arrow-button" id="nextBtn" aria-label="Siguiente">
                        <svg viewBox="0 0 512 512"><path d="M255.5 445c-8.8 0-17.5-3.2-24.3-9.7-13.9-13.3-14.4-35.4-1.1-49.3l155.2-161.1L230.1 63.8c-13.3-13.9-12.8-36 1.1-49.3 13.9-13.3 36-12.8 49.3 1.1l187.6 195.6c6.4 6.7 9.9 15.5 9.9 24.8 0 9.3-3.5 18.1-9.9 24.8L279.5 434.9c-6.5 6.7-15.2 10.1-24 10.1z"/></svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     MARCAS — Swiper Logo Carousel
     ═══════════════════════════════════════════════════════ -->
<section class="py-5" style="background: var(--black);">
    <div class="container-fluid">
        <div class="section-heading" data-reveal="up">
            <span class="section-label">Nuestras Alianzas</span>
            <h2>Marcas Exclusivas</h2>
            <p>Colecciones de los diseñadores más prestigiosos del mundo</p>
        </div>

        <div class="swiper luxury-swiper" data-reveal="up" data-reveal-delay="0.2" id="brands-swiper">
