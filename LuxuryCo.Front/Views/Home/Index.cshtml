        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     STYLES (page-specific)
     ═══════════════════════════════════════════════════════ -->
<style>
    .animated-words-container { display: flex; justify-content: center; }
    .animated-word {
        position: absolute; opacity: 0; transform: translateY(100%);
        transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        width: 100%; text-align: center; font-weight: 600; color: var(--gold);
    }
    .animated-word.active { opacity: 1; transform: translateY(0); }
    .animated-word.out { opacity: 0; transform: translateY(-100%); }

    .recs-card-image { position: absolute; inset: 0; z-index: 1; overflow: hidden; background: #0a0a0a; }
    .recs-card-image img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }

    .brands-slide {
        display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
        height: 220px; position: relative; overflow: hidden; border-radius: 8px;
        cursor: pointer; border: 1px solid var(--border);
        transition: transform 0.4s ease, border-color 0.4s ease;
    }
    .brands-slide:hover { transform: translateY(-6px); border-color: var(--gold); }
    .brands-slide .brand-bg {
        position: absolute; inset: 0;
        background-size: cover; background-position: center top;
        filter: brightness(0.5) grayscale(30%);
        transition: filter 0.4s ease, transform 0.4s ease;
    }
    .brands-slide:hover .brand-bg { filter: brightness(0.65) grayscale(0%); transform: scale(1.05); }
    .brands-slide .brand-info {
        position: relative; z-index: 2; padding: 1rem 1.2rem;
        width: 100%; background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 100%);
    }
    .brands-slide .brand-name {
        font-family: var(--font-display); font-size: 1.1rem; letter-spacing: 3px;
        text-transform: uppercase; color: #fff; font-weight: 600;
    }
    .brands-slide .brand-sub {
        font-size: 0.65rem; letter-spacing: 2px; color: var(--gold); text-transform: uppercase; margin-top: 2px;
    }

    @@keyframes bounce-down {
        0%, 100% { transform: translateX(-50%) translateY(0); }
        50% { transform: translateX(-50%) translateY(8px); }
    }

    /* ── iPhone Mockup CSS ─────────────────────────── */
    .iphone-mockup-wrap {
        perspective: 1200px;
    }
    .iphone-frame {
        position: relative;
        width: 270px;
        height: 555px;
        border-radius: 48px;
        background: linear-gradient(145deg, #b8a99a 0%, #a69a8a 40%, #8c7d70 100%);
        box-shadow:
            0 0 0 1px rgba(255,255,255,0.12),
            0 20px 60px rgba(0,0,0,0.65),
            0 4px 12px rgba(0,0,0,0.4),
            inset 0 1px 0 rgba(255,255,255,0.2);
        padding: 14px;
        box-sizing: border-box;
        transform: rotateY(-6deg) rotateX(2deg);
        transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
    }
    .iphone-frame:hover {
        transform: rotateY(0deg) rotateX(0deg) scale(1.03);
    }
    .iphone-screen {
        width: 100%; height: 100%;
        border-radius: 36px;
        overflow: hidden;
        background: #000;
        position: relative;
    }
    .iphone-wallpaper {
        width: 100%; height: 100%;
        display: flex; flex-direction: column;
        background: #0a0a0a;
        overflow: hidden;
    }
    .iphone-island {
        position: absolute;
        top: 20px; left: 50%;
        transform: translateX(-50%);
        width: 100px; height: 30px;
        background: #000;
        border-radius: 20px;
        z-index: 10;
        box-shadow: 0 1px 4px rgba(0,0,0,0.8);
    }
    .iphone-home-indicator {
        position: absolute;
        bottom: 8px; left: 50%;
        transform: translateX(-50%);
        width: 100px; height: 4px;
        background: rgba(255,255,255,0.5);
        border-radius: 3px;
        z-index: 10;
    }
    /* Botón power (derecha) */
    .iphone-btn-power {
        position: absolute;
        right: -3px; top: 140px;
        width: 3px; height: 65px;
        background: linear-gradient(to bottom, #8c7d70, #a69a8a);
        border-radius: 0 3px 3px 0;
    }
    /* Botones volumen (izquierda) */
    .iphone-btn-vol-up, .iphone-btn-vol-down {
        position: absolute;
        left: -3px;
        width: 3px; height: 44px;
        background: linear-gradient(to bottom, #8c7d70, #a69a8a);
        border-radius: 3px 0 0 3px;
    }
    .iphone-btn-vol-up  { top: 130px; }
    .iphone-btn-vol-down { top: 185px; }

    /* ── Contenido de la App dentro del iPhone ──────── */
    .app-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 52px 16px 10px;
        background: rgba(0,0,0,0.9);
        flex-shrink: 0;
    }
    .app-logo-text {
        font-family: var(--font-display); font-size: 0.75rem;
        letter-spacing: 3px; color: var(--gold); font-weight: 700;
    }
    .app-hero-img {
        flex-shrink: 0; height: 170px; position: relative; overflow: hidden;
    }
    .app-product-grid {
        display: flex; gap: 6px; padding: 10px 12px;
        background: #0a0a0a; flex-shrink: 0;
    }
    .app-mini-card {
        flex: 1; border-radius: 8px; overflow: hidden;
        position: relative; aspect-ratio: 3/4;
        border: 1px solid rgba(212,175,55,0.15);
    }
    .app-mini-card img { width: 100%; height: 100%; object-fit: cover; }
    .app-mini-price {
        position: absolute; bottom: 4px; left: 0; right: 0; text-align: center;
        font-size: 0.55rem; color: var(--gold); font-weight: 700;
        background: rgba(0,0,0,0.7); padding: 2px 0;
    }
    .app-navbar {
        display: flex; justify-content: space-around; align-items: center;
        padding: 10px 8px 18px;
        background: rgba(0,0,0,0.95);
        border-top: 1px solid rgba(212,175,55,0.15);
        margin-top: auto; flex-shrink: 0;
    }
    .app-nav-item {
        display: flex; flex-direction: column; align-items: center;
        gap: 3px; color: #555; font-size: 0.6rem; cursor: pointer;
    }
    .app-nav-item.active { color: var(--gold); }
    .app-nav-item i { font-size: 1rem; }

    /* ── Boutique Info Cards ─────────────────────────── */
    .boutique-info-card {
        background: var(--black-card2, #111);
        border: 1px solid var(--border);
        border-radius: 10px; padding: 1.2rem 1rem;
        transition: border-color 0.3s ease, transform 0.3s ease;
    }
    .boutique-info-card:hover {
        border-color: var(--gold);
        transform: translateY(-3px);
    }
    .boutique-info-icon {
        width: 34px; height: 34px; border-radius: 50%;
        background: rgba(212,175,55,0.1);
        display: flex; align-items: center; justify-content: center;
        margin-bottom: 0.7rem; color: var(--gold); font-size: 0.9rem;
    }
    .boutique-info-card strong {
        display: block; color: var(--text);
        font-size: 0.72rem; letter-spacing: 2px;
        text-transform: uppercase; margin-bottom: 0.4rem;
    }
    .boutique-info-card p {
        color: var(--text-muted); font-size: 0.8rem;
        line-height: 1.6; margin: 0;
    }
</style>


<!-- ═══════════════════════════════════════════════════════
     SCRIPTS
     ═══════════════════════════════════════════════════════ -->
@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function() {

    // ─── Animated Words ───
    const words = document.querySelectorAll(".animated-word");
    let wordIndex = 0;
    if (words.length > 0) {
        setInterval(() => {
            words[wordIndex].classList.remove("active");
            words[wordIndex].classList.add("out");
            wordIndex = (wordIndex + 1) % words.length;
            words[wordIndex].classList.remove("out");
            setTimeout(() => words[wordIndex].classList.add("active"), 50);
        }, 2800);
    }

    // ─── Featured Products Swiper ───
    if (typeof Swiper !== 'undefined') {
        new Swiper('#featured-swiper', {
            slidesPerView: 1.3,
            centeredSlides: true,
            spaceBetween: 20,
            loop: true,
            autoplay: { delay: 4000, disableOnInteraction: false },
            pagination: { el: '.swiper-pagination', clickable: true },
            breakpoints: {
                576:  { slidesPerView: 2,   spaceBetween: 24 },
                768:  { slidesPerView: 2.5, spaceBetween: 28 },
                1024: { slidesPerView: 3.2, spaceBetween: 32 },
                1280: { slidesPerView: 4,   spaceBetween: 28 }
            }
        });
    }

    // ─── Load Featured Products from API (Backend) ───
    const backendUrl = document.querySelector('meta[name="api-base-url"]')?.content || 'https://luxuryco.onrender.com/api';
    fetch(`${backendUrl}/producto`)
        .then(r => r.ok ? r.json() : [])
        .then(products => {
            const wrapper = document.getElementById('featured-wrapper');
            if (!wrapper || !products.length) return;
            const featured = products.filter(p => p.activo && p.stock > 0).slice(0, 12);
            if (!featured.length) return;
            wrapper.innerHTML = featured.map(p => {
                let img = p.imagenPrincipalUrl || 'https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=600&auto=format&fit=crop';
                return `
                <div class="swiper-slide">
                    <a href="/Shop/Product/${p.idProducto}" class="product-card" style="text-decoration:none; display:block;">
                        <div class="card-img-wrap">
                            <img src="${img}" alt="${p.nombre}" loading="lazy" onerror="if(this.src && !this.src.includes('luxuryco.onrender.com') && this.getAttribute('data-fallback') !== 'done'){this.setAttribute('data-fallback','done');this.src='https://luxuryco.onrender.com' + '${p.imagenPrincipalUrl}';}">
                            <div class="card-img-overlay">
                                <span class="badge-luxury badge-gold">Ver Producto</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="card-brand">${p.marcaNombre || 'LuxuryCo'}</div>
                            <div class="card-name">${p.nombre}</div>
                            <div class="card-price">$${Number(p.precio).toLocaleString()} COP</div>
                        </div>
                    </a>
                </div>`;
            }).join('');

            // Re-inicializar Swiper con productos reales
            if (typeof Swiper !== 'undefined') {
                new Swiper('#featured-swiper', {
                    slidesPerView: 1.3,
                    centeredSlides: true,
                    spaceBetween: 20,
                    loop: featured.length > 3,
                    autoplay: { delay: 4000, disableOnInteraction: false },
                    pagination: { el: '.swiper-pagination', clickable: true },
                    breakpoints: {
                        576:  { slidesPerView: 2,   spaceBetween: 24 },
                        768:  { slidesPerView: 2.5, spaceBetween: 28 },
                        1024: { slidesPerView: 3.2, spaceBetween: 32 },
                        1280: { slidesPerView: 4,   spaceBetween: 28 }
                    }
                });
            }
        })
        .catch(() => {});

    // ─── Brands Swiper ───
    const brands = [
        { name: 'GUCCI',         sub: 'Italian Luxury · Since 1921',     img: 'https://images.unsplash.com/photo-1548036328-c9fa89d128fa?q=80&w=600&auto=format&fit=crop' },
        { name: 'PRADA',         sub: 'Milan Fashion · Since 1913',      img: '/images/prada.jpg' },
        { name: 'LOUIS VUITTON', sub: 'Paris Heritage · Since 1854',     img: '/images/LOUIS VUITTON.webp' },
        { name: 'ROLEX',         sub: 'Swiss Mastery · Since 1905',      img: 'https://images.unsplash.com/photo-1523170335258-f5ed11844a49?q=80&w=600&auto=format&fit=crop' },
        { name: 'CARTIER',       sub: 'Fine Jewelry · Since 1847',       img: 'https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?q=80&w=600&auto=format&fit=crop' },
        { name: 'DIOR',          sub: 'French Elegance · Since 1946',    img: '/images/dior.webp' },
        { name: 'CHANEL',        sub: 'Timeless Parisian · Since 1910',  img: '/images/chanel.jpg' },
        { name: 'BALENCIAGA',    sub: 'Avant-Garde · Since 1919',        img: '/images/balensiaga.avif' },
        { name: 'HERMÈS',        sub: 'Artisan Leather · Since 1837',    img: '/images/hermes.webp' },
        { name: 'YSL',           sub: 'Yves Saint Laurent · Since 1961', img: '/images/ysl.jpg' },
    ];

    const brandsWrapper = document.getElementById('brands-wrapper');
    if (brandsWrapper && typeof Swiper !== 'undefined') {
        brandsWrapper.innerHTML = brands.map(b => `
            <div class="swiper-slide brands-slide">
                <div class="brand-bg" style="background-image: url('${b.img}')"></div>
                <div class="brand-info">
                    <div class="brand-name">${b.name}</div>
                    <div class="brand-sub">${b.sub}</div>
                </div>
            </div>
        `).join('');

        new Swiper('#brands-swiper', {
            slidesPerView: 1.5,
            spaceBetween: 16,
            loop: true,
            autoplay: { delay: 2800, disableOnInteraction: false },
            speed: 800,
            breakpoints: {
                576:  { slidesPerView: 2.2, spaceBetween: 20 },
                768:  { slidesPerView: 3.2, spaceBetween: 24 },
                1024: { slidesPerView: 4.2, spaceBetween: 28 },
                1280: { slidesPerView: 5,   spaceBetween: 28 }
            }
        });
    }

    // ─── Testimonials Logic ───
    const testimonials = [
        { quote: "La esencia de LuxuryCo radica en su capacidad de transformar la moda en arte puro. Vestir estas marcas es llevar una obra maestra en cada paso.", name: "Gigi Hadid", designation: "Embajadora de Alta Costura", src: "https://images.unsplash.com/photo-1469334031218-e382a71b716b?q=80&w=1440&auto=format&fit=crop" },
        { quote: "Un estilo que trasciende las tendencias. Para el hombre moderno que valora la sastrería impecable y el diseño vanguardista en cada detalle.", name: "Sean O'Pry", designation: "Ícono de Elegancia Masculina", src: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?q=80&w=1440&auto=format&fit=crop" },
        { quote: "Revolucionando la forma en que entendemos el lujo. Las colecciones curadas por LuxuryCo son simplemente incomparables e inspiradoras.", name: "Bella Hadid", designation: "Modelo de Vanguardia", src: "https://images.unsplash.com/photo-1509631179647-0177331693ae?q=80&w=1440&auto=format&fit=crop" }
    ];

    let tIndex = 0;
    const tTotal = testimonials.length;
    const imgContainer = document.getElementById('imageContainer');
    let tAutoplay = null;

    function calcGap(w) { const mn=400,mx=900,mg=40,xg=70; return w<=mn?mg:w>=mx?xg:mg+(xg-mg)*((w-mn)/(mx-mn)); }

    testimonials.forEach((t, i) => {
        const img = document.createElement('img');
        img.src = t.src; img.alt = t.name; img.className = 'testimonial-image'; img.dataset.index = i;
        imgContainer.appendChild(img);
    });

    function updateTImages() {
        const gap = calcGap(imgContainer.offsetWidth), maxUp = gap * 0.8;
        imgContainer.querySelectorAll('.testimonial-image').forEach((img, i) => {
            const active = i===tIndex, left = (tIndex-1+tTotal)%tTotal===i, right = (tIndex+1)%tTotal===i;
            img.style.zIndex = active?3:left||right?2:1;
            img.style.opacity = active||left||right?1:0;
            img.style.pointerEvents = active||left||right?'auto':'none';
            if (active) img.style.transform = 'translateX(0) translateY(0) scale(1) rotateY(0)';
            else if (left) img.style.transform = `translateX(-${gap}px) translateY(-${maxUp}px) scale(0.85) rotateY(15deg)`;
            else if (right) img.style.transform = `translateX(${gap}px) translateY(-${maxUp}px) scale(0.85) rotateY(-15deg)`;
        });
    }

    function updateTText() {
        const t = testimonials[tIndex];
        document.getElementById('name').textContent = t.name;
        document.getElementById('designation').textContent = t.designation;
        const qEl = document.getElementById('quote');
        qEl.innerHTML = '';
        t.quote.split(' ').forEach((w, i) => {
            const s = document.createElement('span');
            s.textContent = w + '\u00A0';
            s.style.cssText = 'filter:blur(10px); opacity:0; transform:translateY(5px); transition: all 0.35s ease;';
            qEl.appendChild(s);
            setTimeout(() => { s.style.filter='blur(0)'; s.style.opacity='1'; s.style.transform='translateY(0)'; }, 25*i);
        });
    }

    function renderT() { updateTImages(); updateTText(); }
    function resetTAutoplay() { clearInterval(tAutoplay); tAutoplay = setInterval(() => { tIndex=(tIndex+1)%tTotal; renderT(); }, 5500); }

    document.getElementById('nextBtn').addEventListener('click', () => { tIndex=(tIndex+1)%tTotal; renderT(); resetTAutoplay(); });
    document.getElementById('prevBtn').addEventListener('click', () => { tIndex=(tIndex-1+tTotal)%tTotal; renderT(); resetTAutoplay(); });
    window.addEventListener('resize', updateTImages);
    renderT(); resetTAutoplay();
});
</script>
}
