@{
    ViewData["Title"] = "Inicio";
}

<!-- Hero Section -->
<div class="hero-section position-relative" style="height: calc(100vh - 80px); background-image: url('https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=2670&auto=format&fit=crop'); background-size: cover; background-position: center top;">
    <!-- Capa de Partículas Doradas -->
    <div class="hero-canvas" id="capa-particulas" style="position:absolute; z-index:1;"></div>
    
    <!-- Subtle Gradient Overlay for Text Readability -->
    <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(to bottom, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.6) 100%);"></div>
    
    <div class="position-absolute w-100 h-100 d-flex flex-column align-items-center justify-content-center text-center px-3" style="z-index: 10;">
        <h1 class="text-white mb-3 d-flex flex-column align-items-center w-100" style="font-family: 'Playfair Display', serif; font-size: 4rem; letter-spacing: 4px; text-transform: uppercase; line-height: 1.2;">
            <span style="font-size: 2.5rem; letter-spacing: 2px; margin-bottom: 10px;">LuxuryCo es</span>
            <div class="animated-words-container text-gold" style="height: 1.2em; overflow: hidden; position: relative; width: 100vw; max-width: 100%;">
                <span class="animated-word active">Elegancia</span>
                <span class="animated-word">Exclusividad</span>
                <span class="animated-word">Sofisticación</span>
                <span class="animated-word">Vanguardia</span>
            </div>
        </h1>
        <p class="text-white-50 mb-5" style="letter-spacing: 2px; text-transform: uppercase; font-size: 0.9rem; max-width: 600px;">Descubre la elegancia redefinida. Piezas exclusivas diseñadas para inspirar y cautivar.</p>
        <a href="/Shop/Category/Todos" class="btn btn-gold" style="width: auto; padding: 1rem 3rem;">Explorar Ahora</a>
    </div>
</div>

<!-- Título de Sección Modelos -->
<div class="container-fluid text-center mt-5 pt-5">
    <h2 class="recs-title" style="margin-bottom: 20px;">Nuestros Embajadores</h2>
    <p class="text-white-50" style="letter-spacing: 2px; text-transform: uppercase; font-size: 0.9rem;">La elegancia personificada en quienes representan nuestras marcas</p>
</div>

<!-- Testimonials Section (Modelos) -->
<div class="testimonial-container mx-auto">
  <div class="testimonial-grid">
    <div class="image-container" id="imageContainer"></div>
    <div class="testimonial-content">
      <div id="textBlock">
        <h3 class="name" id="name"></h3>
        <p class="designation" id="designation"></p>
        <p class="quote" id="quote"></p>
      </div>
      <div class="arrow-buttons">
        <button class="arrow-button" id="prevBtn" aria-label="Anterior">
          <svg viewBox="0 0 512 512"><path d="M257.5 445c-8.8 0-17.5-3.4-24-10.1L45.9 246.4c-6.4-6.7-9.9-15.5-9.9-24.8 0-9.3 3.5-18.1 9.9-24.8L233.5 12.3c13.3-13.9 35.4-14.4 49.3-1.1 13.9 13.3 14.4 35.4 1.1 49.3L128.7 221.6l155.2 161.1c13.3 13.9 12.8 36-1.1 49.3-6.8 6.5-15.5 9.7-24.3 9.7z"/></svg>
        </button>
        <button class="arrow-button" id="nextBtn" aria-label="Siguiente">
          <svg viewBox="0 0 512 512"><path d="M255.5 445c-8.8 0-17.5-3.2-24.3-9.7-13.9-13.3-14.4-35.4-1.1-49.3l155.2-161.1L230.1 63.8c-13.3-13.9-12.8-36 1.1-49.3 13.9-13.3 36-12.8 49.3 1.1l187.6 195.6c6.4 6.7 9.9 15.5 9.9 24.8 0 9.3-3.5 18.1-9.9 24.8L279.5 434.9c-6.5 6.7-15.2 10.1-24 10.1z"/></svg>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Título de Sección Marcas -->
<div class="container-fluid text-center mt-5 pt-5">
    <h2 class="recs-title" style="margin-bottom: 20px;">Marcas Exclusivas</h2>
    <p class="text-white-50" style="letter-spacing: 2px; text-transform: uppercase; font-size: 0.9rem;">Colecciones de los diseñadores más prestigiosos del mundo</p>
</div>

<!-- Circular Gallery (Marcas) -->
<div class="scroll-spacer">
  <div class="sticky-stage">
    <div class="gallery-root">
      <div class="gallery-track" id="track"></div>
    </div>
    <div class="scroll-hint">↓ SCROLL PARA DESCUBRIR ↓</div>
  </div>
</div>

<!-- Floating Recommendations Widget (Bottom Left) -->
<div id="floating-recs-widget" class="floating-widget">
    <div class="widget-icon">
        <i class="fas fa-gem text-gold"></i>
    </div>
    <div class="widget-text">Recomendaciones del día</div>
</div>

<!-- Recommendations Overlay -->
<div id="recs-overlay" class="recs-overlay d-none">
    <button id="close-recs" class="close-btn"><i class="fas fa-times"></i></button>
    <div class="stage">
        <h3 class="recs-title">Recomendaciones del día</h3>
        <div class="stack-wrapper" id="recs-stack"></div>
        <div class="hint">Haz clic en la carta frontal para ver la siguiente</div>
    </div>
</div>

<style>
    .hover-zoom:hover {
        transform: scale(1.05);
    }
    
    /* Animated Words CSS */
    .animated-words-container {
        display: flex;
        justify-content: center;
    }
    
    .animated-word {
        position: absolute;
        opacity: 0;
        transform: translateY(100%);
        transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        width: 100%;
        text-align: center;
        font-weight: 600;
    }
    
    .animated-word.active {
        opacity: 1;
        transform: translateY(0);
    }
    
    .animated-word.out {
        opacity: 0;
        transform: translateY(-100%);
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const words = document.querySelectorAll(".animated-word");
            let currentIndex = 0;
            
            if(words.length === 0) return;

            setInterval(() => {
                // Current word goes up and out
                words[currentIndex].classList.remove("active");
                words[currentIndex].classList.add("out");
                
                // Next word comes in from bottom
                currentIndex = (currentIndex + 1) % words.length;
                
                // Reset the new current word's position instantly before animating it in
                words[currentIndex].classList.remove("out");
                
                // Small delay to allow CSS to apply the reset before adding active class
                setTimeout(() => {
                    words[currentIndex].classList.add("active");
                }, 50);
                
            }, 2500); // Change word every 2.5 seconds
            
            // Lógica del Widget de Recomendaciones
            const widget = document.getElementById('floating-recs-widget');
            const overlay = document.getElementById('recs-overlay');
            const closeBtn = document.getElementById('close-recs');
            const stack = document.getElementById('recs-stack');
            
            let products = [];
            let order = [];
            
            widget.addEventListener('click', () => {
                overlay.classList.remove('d-none');
                if (products.length === 0) {
                    fetchProducts();
                }
            });
            
            closeBtn.addEventListener('click', () => {
                overlay.classList.add('d-none');
            });
            
            async function fetchProducts() {
                try {
                    const res = await fetch('https://luxuryco.onrender.com/api/producto');
                    if (res.ok) {
                        const data = await res.json();
                        // Tomar 5 aleatorios
                        products = data.sort(() => 0.5 - Math.random()).slice(0, 5);
                        order = Array.from({length: products.length}, (_, i) => i);
                        renderStack();
                    }
                } catch(e) {
                    console.error('Error cargando recomendaciones', e);
                }
            }
            
            function renderStack() {
                stack.innerHTML = '';
                order.forEach((cardIndex, depth) => {
                    const p = products[cardIndex];
                    const el = document.createElement('div');
                    el.className = 'recs-card';
                    
                    const offsetX = depth * 10;
                    const offsetY = depth * -6;
                    const rotate = depth * 4.5;
                    const scale = 1 - depth * 0.035;

                    el.style.transform = `translate(${offsetX}px, ${offsetY}px) rotate(${rotate}deg) scale(${scale})`;
                    el.style.zIndex = 100 - depth;
                    el.style.boxShadow = depth === 0
                        ? '0 14px 34px rgba(0,0,0,0.5), 0 3px 10px rgba(0,0,0,0.3)'
                        : '0 6px 16px rgba(0,0,0,0.3)';

                    const imageUrl = p.imagenPrincipalUrl ? p.imagenPrincipalUrl : 'https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=2670&auto=format&fit=crop';
                    
                    el.innerHTML = `
                        <div class="recs-card-image" style="background-image: url('${imageUrl}'); background-size: contain; background-repeat: no-repeat; background-position: center top; background-color: #111;">
                            <div class="recs-card-overlay"></div>
                        </div>
                        <div class="recs-card-label">
                            ${p.nombre}
                            <span class="recs-card-sub">$${p.precio.toLocaleString()} USD</span>
                        </div>
                    `;

                    if (depth === 0) {
                        el.addEventListener('click', (e) => {
                            if (e.target.tagName.toLowerCase() !== 'a') {
                                cycle();
                            }
                        });
                        
                        const link = document.createElement('a');
                        link.href = `/Shop/Product/${p.idProducto}`;
                        link.className = 'recs-btn-link';
                        link.innerHTML = 'Ir al producto';
                        el.appendChild(link);
                    }

                    stack.appendChild(el);
                });
            }

            function cycle() {
                if(order.length === 0) return;
                const front = stack.querySelector('.recs-card');
                front.style.transition = 'transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease';
                front.style.transform += ' translate(120px, 40px) rotate(22deg)';
                front.style.opacity = '0';

                setTimeout(() => {
                    order.push(order.shift());
                    renderStack();
                }, 230);
            }
            
            // ==========================================
            // TESTIMONIALS (MODELOS) LOGIC
            // ==========================================
            const testimonials = [
                {
                    quote: "La esencia de LuxuryCo radica en su capacidad de transformar la moda en arte puro. Vestir estas marcas es llevar una obra maestra en cada paso.",
                    name: "Gigi Hadid",
                    designation: "Embajadora de Alta Costura",
                    src: "https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=1440&auto=format&fit=crop"
                },
                {
                    quote: "Un estilo que trasciende las tendencias. Para el hombre moderno que valora la sastrería impecable y el diseño vanguardista en cada detalle.",
                    name: "Sean O'Pry",
                    designation: "Ícono de Elegancia Masculina",
                    src: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?q=80&w=1440&auto=format&fit=crop"
                },
                {
                    quote: "Revolucionando la forma en que entendemos el lujo. Las colecciones curadas por LuxuryCo son simplemente incomparables e inspiradoras.",
                    name: "Bella Hadid",
                    designation: "Modelo de Vanguardia",
                    src: "https://images.unsplash.com/photo-1524504388940-b1c1722653e1?q=80&w=1440&auto=format&fit=crop"
                }
            ];

            let activeIndex = 0;
            const total = testimonials.length;
            const imageContainer = document.getElementById('imageContainer');
            let autoplayInterval = null;

            function calculateGap(width) {
                const minWidth = 400, maxWidth = 900, minGap = 40, maxGap = 70;
                if (width <= minWidth) return minGap;
                if (width >= maxWidth) return maxGap;
                return minGap + (maxGap - minGap) * ((width - minWidth) / (maxWidth - minWidth));
            }

            testimonials.forEach((t, i) => {
                const img = document.createElement('img');
                img.src = t.src;
                img.alt = t.name;
                img.className = 'testimonial-image';
                img.dataset.index = i;
                imageContainer.appendChild(img);
            });

            function updateImages() {
                const gap = calculateGap(imageContainer.offsetWidth);
                const maxStickUp = gap * 0.8;
                const imgs = imageContainer.querySelectorAll('.testimonial-image');

                imgs.forEach((img, index) => {
                    const isActive = index === activeIndex;
                    const isLeft = (activeIndex - 1 + total) % total === index;
                    const isRight = (activeIndex + 1) % total === index;

                    if (isActive) {
                        img.style.zIndex = 3;
                        img.style.opacity = 1;
                        img.style.pointerEvents = 'auto';
                        img.style.transform = `translateX(0px) translateY(0px) scale(1) rotateY(0deg)`;
                    } else if (isLeft) {
                        img.style.zIndex = 2;
                        img.style.opacity = 1;
                        img.style.pointerEvents = 'auto';
                        img.style.transform = `translateX(-${gap}px) translateY(-${maxStickUp}px) scale(0.85) rotateY(15deg)`;
                    } else if (isRight) {
                        img.style.zIndex = 2;
                        img.style.opacity = 1;
                        img.style.pointerEvents = 'auto';
                        img.style.transform = `translateX(${gap}px) translateY(-${maxStickUp}px) scale(0.85) rotateY(-15deg)`;
                    } else {
                        img.style.zIndex = 1;
                        img.style.opacity = 0;
                        img.style.pointerEvents = 'none';
                    }
                });
            }

            function updateText() {
                const t = testimonials[activeIndex];
                document.getElementById('name').textContent = t.name;
                document.getElementById('designation').textContent = t.designation;

                const quoteEl = document.getElementById('quote');
                quoteEl.innerHTML = '';
                t.quote.split(' ').forEach((word, i) => {
                    const span = document.createElement('span');
                    span.textContent = word + '\u00A0';
                    span.style.filter = 'blur(10px)';
                    span.style.opacity = '0';
                    span.style.transform = 'translateY(5px)';
                    quoteEl.appendChild(span);

                    setTimeout(() => {
                        span.style.filter = 'blur(0px)';
                        span.style.opacity = '1';
                        span.style.transform = 'translateY(0)';
                    }, 25 * i);
                });
            }

            function renderTestimonials() {
                updateImages();
                updateText();
            }

            function goNext() {
                activeIndex = (activeIndex + 1) % total;
                renderTestimonials();
                resetAutoplay();
            }

            function goPrev() {
                activeIndex = (activeIndex - 1 + total) % total;
                renderTestimonials();
                resetAutoplay();
            }

            function resetAutoplay() {
                if (autoplayInterval) clearInterval(autoplayInterval);
                autoplayInterval = setInterval(() => {
                    activeIndex = (activeIndex + 1) % total;
                    renderTestimonials();
                }, 5000);
            }

            document.getElementById('nextBtn').addEventListener('click', goNext);
            document.getElementById('prevBtn').addEventListener('click', goPrev);
            window.addEventListener('resize', updateImages);
            renderTestimonials();
            resetAutoplay();
            
            // ==========================================
            // CIRCULAR GALLERY (MARCAS) LOGIC
            // ==========================================
            const galleryData = [
                { common: "GUCCI", binomial: "Italian Luxury House", url: "https://images.unsplash.com/photo-1548036328-c9fa89d128fa?w=700&auto=format&fit=crop&q=80", by: "LuxuryCo" },
                { common: "PRADA", binomial: "Milan Fashion", url: "https://images.unsplash.com/photo-1579632483866-9e90954b83fb?w=700&auto=format&fit=crop&q=80", by: "LuxuryCo" },
                { common: "LOUIS VUITTON", binomial: "Paris Heritage", url: "https://images.unsplash.com/photo-1548624149-f9b1859aa7d0?w=700&auto=format&fit=crop&q=80", by: "LuxuryCo" },
                { common: "ROLEX", binomial: "Swiss Mastery", url: "https://images.unsplash.com/photo-1523170335258-f5ed11844a49?w=700&auto=format&fit=crop&q=80", by: "LuxuryCo" },
                { common: "CARTIER", binomial: "Paris Fine Jewelry", url: "https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=700&auto=format&fit=crop&q=80", by: "LuxuryCo" },
                { common: "DIOR", binomial: "French Elegance", url: "https://images.unsplash.com/photo-1588829447225-b4618e7e31b8?w=700&auto=format&fit=crop&q=80", by: "LuxuryCo" },
                { common: "CHANEL", binomial: "Timeless Parisian", url: "https://images.unsplash.com/photo-1541099649105-f69ad21f3246?w=700&auto=format&fit=crop&q=80", by: "LuxuryCo" },
                { common: "BALENCIAGA", binomial: "Avant-Garde", url: "https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?w=700&auto=format&fit=crop&q=80", by: "LuxuryCo" },
                { common: "HERMÈS", binomial: "Artisan Leather", url: "https://images.unsplash.com/photo-1598532163257-ae3c6b2524b6?w=700&auto=format&fit=crop&q=80", by: "LuxuryCo" },
                { common: "YSL", binomial: "Yves Saint Laurent", url: "https://images.unsplash.com/photo-1601004890684-d8cbf643f5f2?w=700&auto=format&fit=crop&q=80", by: "LuxuryCo" },
            ];

            const radius = 480;
            const autoRotateSpeed = 0.05;
            const anglePerItem = 360 / galleryData.length;
            const track = document.getElementById('track');
            
            let rotation = 0;
            let isScrolling = false;
            let scrollTimeout = null;

            const itemEls = galleryData.map((item, i) => {
                const wrapper = document.createElement('div');
                wrapper.className = 'gallery-item';

                wrapper.innerHTML = `
                  <div class="gallery-card">
                    <img src="${item.url}" alt="${item.common}" style="object-position: center;">
                    <div class="card-caption">
                      <h2>${item.common}</h2>
                      <em>${item.binomial}</em>
                      <div class="by">${item.by}</div>
                    </div>
                  </div>
                `;
                track.appendChild(wrapper);
                return wrapper;
            });

            function updateGalleryItems() {
                itemEls.forEach((el, i) => {
                    const itemAngle = i * anglePerItem;
                    const totalRotation = ((rotation % 360) + 360) % 360;
                    const relativeAngle = (itemAngle + totalRotation + 360) % 360;
                    const normalizedAngle = Math.abs(relativeAngle > 180 ? 360 - relativeAngle : relativeAngle);
                    const opacity = Math.max(0.25, 1 - (normalizedAngle / 180));

                    el.style.transform = `rotateY(${itemAngle}deg) translateZ(${radius}px)`;
                    el.style.opacity = opacity;
                });
                track.style.transform = `rotateY(${rotation}deg)`;
            }

            function handleScroll() {
                isScrolling = true;
                if (scrollTimeout) clearTimeout(scrollTimeout);

                // Start scrolling calculation relative to the component position if possible
                // For simplicity, using overall document scroll since the spacer is huge
                const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
                const scrollProgress = scrollableHeight > 0 ? window.scrollY / scrollableHeight : 0;
                
                // Adjust rotation sensitivity
                rotation = scrollProgress * 720; // 720 degrees over full scroll
                updateGalleryItems();

                scrollTimeout = setTimeout(() => { isScrolling = false; }, 150);
            }

            function autoRotateGallery() {
                if (!isScrolling) {
                    rotation += autoRotateSpeed;
                    updateGalleryItems();
                }
                requestAnimationFrame(autoRotateGallery);
            }

            window.addEventListener('scroll', handleScroll, { passive: true });
            requestAnimationFrame(autoRotateGallery);
            updateGalleryItems();
        });
    </script>
}
