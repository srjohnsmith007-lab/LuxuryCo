                                    </div>
                                </div>
                                <div class="app-product-grid">
                                    <div class="app-mini-card">
                                        <img src="https://images.unsplash.com/photo-1543163521-1bf539c55dd2?q=80&w=200&auto=format&fit=crop" alt="">
                                        <div class="app-mini-price">$350K</div>
                                    </div>
                                    <div class="app-mini-card">
                                        <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=200&auto=format&fit=crop" alt="">
                                        <div class="app-mini-price">$820K</div>
                                    </div>
                                    <div class="app-mini-card">
                                        <img src="https://images.unsplash.com/photo-1539109136881-3be0616acf4b?q=80&w=200&auto=format&fit=crop" alt="">
                                        <div class="app-mini-price">$610K</div>
                                    </div>
                                </div>
                                <!-- Bottom bar del "app" -->
                                <div class="app-navbar">
                                    <div class="app-nav-item active"><i class="fas fa-home"></i><span>Inicio</span></div>
