<div id="ai-stylist-widget" class="floating-chat-container">
    <!-- Botón Flotante -->
    <button id="ai-stylist-toggle" class="btn-floating-chat shadow-lg">
        <i class="fas fa-gem me-1"></i> Asesor de Estilo
    </button>

    <!-- Ventana del Chat -->
    <div id="ai-stylist-box" class="chat-window shadow-lg d-none">
        <div class="chat-header d-flex justify-content-between align-items-center">
            <div>
                <i class="fas fa-gem text-gold me-2"></i>
                <span class="fw-bold">LuxuryCo Stylist</span>
            </div>
            <div class="d-flex align-items-center gap-1">
                <button class="btn btn-sm text-gold px-2" id="btn-tryon-toggle" title="Probador Virtual">
                    <i class="fas fa-tshirt"></i>
                </button>
                <button class="btn btn-sm text-white px-2" onclick="clearStylistChat()" title="Limpiar">
                    <i class="fas fa-trash-alt"></i>
                </button>
                <button class="btn btn-sm text-white px-2" id="ai-stylist-close">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>

        <!-- Panel Probador Virtual -->
        <div id="tryon-panel" class="tryon-panel d-none">
            <div class="tryon-panel-header">
                <i class="fas fa-tshirt text-gold me-2"></i>
                <span>Probador Virtual con IA</span>
                <button class="btn btn-sm text-white ms-auto" id="btn-tryon-close" title="Cerrar">
                    <i class="fas fa-chevron-down"></i>
                </button>
            </div>

            <!-- Upload de foto -->
            <div class="tryon-upload-area" id="tryon-drop-zone">
                <input type="file" id="tryon-photo-input" accept="image/jpeg,image/png,image/webp" style="display:none">
                <div id="tryon-upload-placeholder" onclick="document.getElementById('tryon-photo-input').click()">
                    <i class="fas fa-camera tryon-camera-icon"></i>
                    <p class="mb-1">Sube tu foto</p>
                    <small>JPG, PNG o WEBP</small>
                </div>
                <div id="tryon-preview-container" class="d-none">
                    <img id="tryon-photo-preview" class="tryon-preview-img" alt="Tu foto">
                    <button class="btn-tryon-remove" onclick="removeTryOnPhoto()" title="Quitar foto">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>

            <!-- Prenda a probar -->
            <div class="tryon-fields">
                <label class="tryon-label">Categor&iacute;a de la prenda</label>
                <select id="tryon-category" class="tryon-select">
                    <option value="tops">&#128084; Camisa / Top / Chaqueta</option>
                    <option value="bottoms">&#128096; Pantalon / Falda / Shorts</option>
                    <option value="one-pieces">&#128163; Vestido / Overall</option>
                </select>

                <label class="tryon-label mt-2">Prenda a probarte</label>
                <input type="text" id="tryon-garment-desc" class="tryon-input"
                       placeholder="Ej: camisa negra de lino manga larga...">
                <small class="tryon-hint">Puedes escribirlo o seleccionar un producto del chat</small>
            </div>

            <!-- Boton de accion -->
            <button id="btn-tryon-run" class="btn-tryon-run" onclick="runVirtualTryOn()">
                <i class="fas fa-magic me-2"></i>Probarme esta prenda
            </button>

            <!-- Estado de carga -->
            <div id="tryon-loading" class="tryon-loading d-none">
                <div class="tryon-spinner"></div>
                <p class="tryon-loading-text">Analizando tu foto y ajustando la prenda...<br><small>Esto puede tomar 15-40 segundos</small></p>
            </div>
        </div>
        <!-- /Panel Probador Virtual -->

        <div class="chat-body" id="stylist-messages">
            <!-- El saludo se genera dinamicamente en JS segun la pagina -->
        </div>
        
        <div id="stylist-typing" class="typing-indicator d-none p-2 mb-2">
            <div class="typing-line"></div>
        </div>
         <div class="chat-footer" style="padding: 12px; background: transparent; border-top: none;">
             <!-- Input de archivo oculto (hidden) -->
             <input type="file" id="stylist-file-upload" accept="image/*" style="display:none !important;">

             <form id="stylist-form">
                 <div class="chat-bar-widget">
                     <div class="chat-input-wrapper-widget">
                         <input type="text" id="stylist-input" placeholder="Escribe tu consulta aquí..." autocomplete="off">
                     </div>
                     <div class="chat-row-widget">
                         <div class="chat-icons-widget">
                             <button type="button" class="icon-btn-widget" id="btn-upload-image" title="Sube una imagen">
                                 <svg viewBox="0 0 24 24"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                             </button>
                         </div>
                         <div class="chat-actions-right-widget">
                             <button type="button" class="icon-btn-widget" id="btn-voice-mic" title="Chat de voz">
                                 <svg viewBox="0 0 24 24" id="mic-widget-svg"><path d="M12 1a4 4 0 0 0-4 4v6a4 4 0 0 0 8 0V5a4 4 0 0 0-4-4z"/><path d="M19 10v1a7 7 0 0 1-14 0v-1"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
                             </button>
                             <button type="submit" class="send-btn-icon-widget" title="Enviar consulta">
                                 <svg viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                             </button>
                         </div>
                     </div>
                 </div>
             </form>
         </div>
    </div>
</div>
<script src="~/js/voice_assistant.js"></script>

<style>
    :root {
        --chat-primary: #000000;
        --chat-secondary: #1a1a1a;
        --chat-accent: #C9A84C;
        --chat-text: #e0e0e0;
    }

    .floating-chat-container {
        position: fixed;
        bottom: 30px;
        right: 30px;
        z-index: 9999;
        font-family: 'Inter', sans-serif;
    }

    .btn-floating-chat {
        background-color: var(--chat-primary);
        color: var(--chat-accent);
        border: 1px solid var(--chat-accent);
        border-radius: 30px;
        padding: 12px 24px;
        font-weight: bold;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(201, 168, 76, 0.3) !important;
    }

    .btn-floating-chat:hover {
        background-color: var(--chat-accent);
        color: var(--chat-primary);
        transform: translateY(-2px);
    }

    .chat-window {
        width: 560px;
        height: 520px;
        max-height: 80vh;
        background-color: rgba(5, 5, 5, 0.92);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(201, 168, 76, 0.25);
        box-shadow: 0 10px 40px rgba(0,0,0,0.9), inset 0 0 0 1px rgba(255,255,255,0.05) !important;
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        position: absolute;
        bottom: 60px;
        right: 0;
        transform-origin: bottom right;
        animation: scaleIn 0.3s cubic-bezier(0.19, 1, 0.22, 1);
    }

    @@keyframes scaleIn {
        from { transform: scale(0.5); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    .chat-header {
        background-color: rgba(15, 15, 15, 0.85);
        padding: 15px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        color: white;
    }

    .text-gold {
        color: var(--chat-accent);
    }

    .chat-body {
        flex: 1;
        padding: 15px;
        overflow-y: auto;
        background-color: transparent;
    }

    /* Scrollbar */
    .chat-body::-webkit-scrollbar { width: 4px; }
    .chat-body::-webkit-scrollbar-track { background: transparent; }
    .chat-body::-webkit-scrollbar-thumb { background-color: #333; border-radius: 10px; }

    .msg-bubble {
        max-width: 85%;
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 0.9rem;
        line-height: 1.4;
        word-wrap: break-word;
    }

    .ai-bubble {
        background-color: var(--chat-secondary);
        color: var(--chat-text);
        border-left: 2px solid var(--chat-accent);
        margin-right: auto;
        border-bottom-left-radius: 0;
    }

    .user-bubble {
        background-color: #222;
        color: white;
        margin-left: auto;
        border-bottom-right-radius: 0;
    }

    /* Línea de Carga (Typing Indicator) */
    .typing-line {
        width: 40px;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--chat-accent), transparent);
        animation: pulseLine 1.5s ease-in-out infinite;
        margin-left: 10px;
    }
    @@keyframes pulseLine {
        0% { opacity: 0.3; transform: scaleX(0.5); }
        50% { opacity: 1; transform: scaleX(1); box-shadow: 0 0 10px rgba(201,168,76,0.6); }
        100% { opacity: 0.3; transform: scaleX(0.5); }
    }    .chat-footer {
        padding: 14px;
        background-color: transparent;
        flex-shrink: 0;
    }

    /* Elegant Custom chat-bar for widget */
    .chat-bar-widget {
        background: #141418;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 20px;
        padding: 14px 16px 10px 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.25);
        transition: border-color 0.25s, box-shadow 0.25s;
    }
    .chat-bar-widget:focus-within {
        border-color: rgba(201, 168, 76, 0.4);
        box-shadow: 0 10px 30px rgba(201, 168, 76, 0.08);
    }
    .chat-input-wrapper-widget {
        margin-bottom: 10px;
    }
    .chat-input-wrapper-widget input {
        width: 100%;
        background: transparent;
        border: none !important;
        outline: none !important;
        color: #fff;
        font-size: 0.9rem;
        padding: 4px 0;
        box-shadow: none !important;
    }
    .chat-input-wrapper-widget input::placeholder {
        color: #555;
    }
    .chat-row-widget {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .chat-icons-widget {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .chat-actions-right-widget {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .icon-btn-widget {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 50%;
        cursor: pointer;
        color: #8b93a1;
        transition: all 0.25s ease;
        padding: 0;
    }
    .icon-btn-widget:hover {
        color: var(--chat-accent);
        background: rgba(201, 168, 76, 0.1);
        border-color: rgba(201, 168, 76, 0.2);
        transform: translateY(-1px);
    }
    .icon-btn-widget svg {
        width: 15px;
        height: 15px;
        stroke: currentColor;
        stroke-width: 1.8;
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .send-btn-icon-widget {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        background: var(--chat-accent);
        border: none;
        border-radius: 50%;
        cursor: pointer;
        color: #000;
        transition: all 0.25s ease;
        padding: 0;
    }
    .send-btn-icon-widget:hover {
        background: #f0c940;
        transform: scale(1.05);
        box-shadow: 0 0 10px rgba(201, 168, 76, 0.3);
    }
    .send-btn-icon-widget svg {
        width: 14px;
                        }
                    );
                } else {
                    // VoiceAssistant no disponible — mostrar mensaje amigable
                    addMessageToUI('⚠️ El asistente de voz no está disponible en este momento. Escribe tu consulta directamente.', 'ai', false);
                }
            });
        }
    })();

    // ── Lógica de Subida de Imagen para Probador Virtual ──
    let uploadedImageBase64 = null;
    let uploadedImageMime = null;

    const btnUpload = document.getElementById('btn-upload-image');
    const fileUploadInput = document.getElementById('stylist-file-upload');

    if (btnUpload && fileUploadInput) {
        btnUpload.addEventListener('click', () => {
            fileUploadInput.click();
        });

        fileUploadInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file) return;

            // Validar tipo y tamaño (máx 5MB)
            if (!file.type.startsWith('image/')) {
                addMessageToUI('⚠️ Solo puedes subir imágenes (JPG, PNG, WEBP).', 'ai', false);
                return;
            }
            if (file.size > 5 * 1024 * 1024) {
                addMessageToUI('⚠️ La imagen es muy grande. Máximo 5 MB.', 'ai', false);
                return;
            }

            uploadedImageMime = file.type;
            const reader = new FileReader();
            reader.onload = (ev) => {
                const fullDataUrl = ev.target.result;
                // Extraer solo el base64 sin el prefijo data:image/...;base64,
                uploadedImageBase64 = fullDataUrl.split(',')[1];

                // Mostrar preview en el chat
                showImagePreviewInChat(fullDataUrl, file.name);
            };
            reader.readAsDataURL(file);
            // Limpiar el input para permitir re-selección del mismo archivo
            fileUploadInput.value = '';
        });
    }

    function showImagePreviewInChat(dataUrl, fileName) {
        // Remover preview anterior si existe
        const existing = document.getElementById('upload-preview-bubble');
        if (existing) existing.remove();

        const previewBubble = document.createElement('div');
        previewBubble.id = 'upload-preview-bubble';
        previewBubble.className = 'upload-preview-bubble mx-2 mb-1';
        previewBubble.innerHTML = `
            <img src="${dataUrl}" alt="Tu foto">
            <div class="upload-info">
                <div><strong style="color:var(--chat-accent);font-size:0.75rem;"><i class="fas fa-camera me-1"></i>Foto lista para probador virtual</strong></div>
                <div style="color:#888;">${fileName}</div>
                <div style="color:#aaa; font-size:0.7rem;">Ahora dime qué prenda quieres probar, ej: "ponme una camisa azul"</div>
            </div>
            <button class="btn-clear-upload" onclick="clearUploadedImage()" title="Quitar foto">
                <i class="fas fa-times"></i>
            </button>
        `;

        // Insertar antes del chat-footer (el form)
        const footer = document.getElementById('stylist-form');
        footer.parentNode.insertBefore(previewBubble, footer);

        // Cambiar color del botón de cámara para indicar que hay foto
        if (btnUpload) {
            btnUpload.style.background = 'rgba(201,168,76,0.4)';
            btnUpload.title = 'Cambiar foto';
        }

        scrollToBottom();
    }

    function clearUploadedImage() {
        uploadedImageBase64 = null;
        uploadedImageMime = null;
        const preview = document.getElementById('upload-preview-bubble');
        if (preview) preview.remove();
        if (btnUpload) {
            btnUpload.style.background = '';
            btnUpload.title = 'Subir foto para Probador Virtual';
        }
    }

    // Sobrescribir el submit del formulario para incluir la imagen si está disponible
    const stylistFormOverride = document.getElementById('stylist-form');
    const originalSubmitHandler = stylistFormOverride.onsubmit;

    stylistFormOverride.addEventListener('submit', async (e) => {
        // Si hay imagen subida, usar flujo de Virtual Try-On directo
        if (uploadedImageBase64) {
            e.preventDefault();
            e.stopImmediatePropagation();

            const garmentText = stylistInput.value.trim() || 'una prenda de estilo elegante';
            stylistInput.value = '';

            // Capturar referencias ANTES de limpiar
            const capturedBase64 = uploadedImageBase64;
            const capturedMime = uploadedImageMime || 'image/jpeg';

            // Mostrar mensaje de usuario con indicador de foto
            const userBubble = document.createElement('div');
            userBubble.className = 'msg-bubble user-bubble ms-auto mb-3';
            userBubble.innerHTML = `<i class="fas fa-camera me-2 text-gold"></i>${garmentText}`;
            stylistMessages.appendChild(userBubble);

            // Quitar preview
            clearUploadedImage();

            // Mostrar typing
            stylistTyping.classList.remove('d-none');
            scrollToBottom();

            try {
                const tryonResponse = await fetch('/Home/VirtualTryOn', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        userPhotoBase64: capturedBase64,
                        userPhotoMimeType: capturedMime,
                        garmentDescription: garmentText,
                        garmentImageUrl: null,
                        productId: lastShownProductId || null,
                        category: 'tops',
                        seed: null
                    })
                });

                const rawText = await tryonResponse.text();
                let data;
                try { data = JSON.parse(rawText); } catch { data = { errorMessage: rawText }; }

                stylistTyping.classList.add('d-none');

                if (tryonResponse.ok && data.imageUrl) {
                    const resultBubble = document.createElement('div');
                    resultBubble.className = 'msg-bubble ai-bubble mb-3';
                    resultBubble.innerHTML = `
                        <div class="fw-bold mb-2"><i class="fas fa-tshirt text-gold me-2"></i>Probador Virtual IA</div>
                        <img src="${data.imageUrl}" alt="Resultado probador virtual" class="generated-luxury-img rounded mb-2" style="max-width:100%;">
                        <div style="font-size:0.7rem; color:#aaa; background:rgba(201,168,76,0.08); border:1px solid rgba(201,168,76,0.2); border-radius:6px; padding:6px 8px;">
                            <i class="fas fa-exclamation-triangle me-1"></i>
                            <strong>Aviso:</strong> El agente puede cometer errores. Esta imagen es solo un estimado; si desea más realismo y precisión, puede adquirir el plan Premium de Luxury.
                        </div>
                    `;
                    stylistMessages.appendChild(resultBubble);
                } else {
                    addMessageToUI('⚠️ No pude procesar el probador virtual. Intenta de nuevo con otra foto o prenda.', 'ai', false);
                }
            } catch (err) {
                stylistTyping.classList.add('d-none');
                addMessageToUI('⚠️ Error de conexión con el probador virtual.', 'ai', false);
            }

            scrollToBottom();
        }
        // Si no hay imagen, el flujo normal de texto continúa (otros listeners del submit)
    }, true); // capture=true para ejecutarse antes

    // ── Lógica Modal Seguro de Registro (Zero-Password) ──

    let currentSecureToken = null;

    function openSecureRegistrationModal(token) {
        currentSecureToken = token;
        const modalHtml = `
            <div id="secure-registration-modal" class="secure-modal-overlay">
                <div class="secure-modal-box">
                    <h5 class="text-gold mb-3"><i class="fas fa-lock me-2"></i>Registro Seguro</h5>
                    <p style="font-size:0.8rem; color:#aaa;">Crea una contraseña segura para finalizar tu registro. La IA no tiene acceso a esta información.</p>
                    <form id="secure-reg-form" onsubmit="submitSecureRegistration(event)">
                        <label style="font-size:0.75rem; color:#888;">Contraseña Segura</label>
                        <input type="password" id="secure-reg-pwd" required minlength="8" placeholder="Min. 8 caracteres, números y símbolos">
                        <label style="font-size:0.75rem; color:#888;">Confirmar Contraseña</label>
                        <input type="password" id="secure-reg-pwd2" required minlength="8" placeholder="Confirma tu contraseña">
                        
                        <div id="secure-reg-error" class="text-danger mb-2 d-none" style="font-size:0.75rem;"></div>

                        <div class="d-flex gap-2 mt-3">
                            <button type="button" class="btn btn-outline-secondary btn-sm flex-fill" onclick="closeSecureRegistrationModal()">Cancelar</button>
                            <button type="submit" class="btn btn-primary btn-sm flex-fill" id="secure-reg-btn">Registrarme Seguramente</button>
                        </div>
                    </form>
                </div>
            </div>
        `;
        document.body.insertAdjacentHTML('beforeend', modalHtml);
        chatBox.classList.add('d-none'); // Ocultar chat por seguridad
    }

    function closeSecureRegistrationModal() {
        const modal = document.getElementById('secure-registration-modal');
        if (modal) modal.remove();
        currentSecureToken = null;
        chatBox.classList.remove('d-none');
    }

    async function submitSecureRegistration(e) {
        e.preventDefault();
        const pwd = document.getElementById('secure-reg-pwd').value;
        const pwd2 = document.getElementById('secure-reg-pwd2').value;
        const errorDiv = document.getElementById('secure-reg-error');
        const btn = document.getElementById('secure-reg-btn');

        if (pwd !== pwd2) {
            errorDiv.innerText = "Las contraseñas no coinciden.";
            errorDiv.classList.remove('d-none');
            return;
        }

        errorDiv.classList.add('d-none');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Registrando...';

        try {
            const response = await fetch('/Account/CompleteSecureRegistration', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ Token: currentSecureToken, Password: pwd })
            });

            if (!response.ok) {
                const data = await response.json();
                throw new Error(data.message || "Error de validación.");
            }

            // Exito
            closeSecureRegistrationModal();
            const textToAppend = "<i class='fas fa-check-circle text-success me-2'></i> <strong>¡Registro Exitoso!</strong> Bienvenido a LuxuryCo. Ya estás conectado de forma segura.";
            
            const bubble = document.createElement('div');
            bubble.className = "msg-bubble ai-bubble";
            bubble.innerHTML = textToAppend;
            stylistMessages.appendChild(bubble);
            scrollToBottom();

            setTimeout(() => window.location.reload(), 2000); 
            
        } catch (error) {
            errorDiv.innerText = error.message;
            errorDiv.classList.remove('d-none');
            btn.disabled = false;
            btn.innerText = 'Registrarme Seguramente';
        }
    }
</script>
