@using LuxuryCo.Front.ViewModels
@model ProductoViewModel

@{
    var prodName = Model?.Nombre ?? "Producto LuxuryCo";
    var prodPrice = Model?.Precio ?? 0;
    var prodBrand = Model?.MarcaNombre ?? "LuxuryCo";
    var prodDesc = Model?.Descripcion ?? "Una pieza única de la colección exclusiva de LuxuryCo.";
    var prodStock = Model?.Stock ?? 0;
    var imgUrl = !string.IsNullOrEmpty(Model?.ImagenPrincipalUrl)
        ? Model.ImagenPrincipalUrl
        : "https://images.unsplash.com/photo-1618517351616-38fb9c5210c6?q=80&w=800&auto=format&fit=crop";
    var allImages = Model?.ImagenesUrls != null && Model.ImagenesUrls.Count > 0
        ? Model.ImagenesUrls
        : new List<string> { imgUrl };

    ViewData["Title"] = prodName + " | LuxuryCo";
}

<style>
    /* ── Product Detail specific styles ── */
    .pd-breadcrumb {
        padding: 18px 40px;
        font-size: 0.78rem;
        color: var(--text-muted);
        letter-spacing: 1px;
        border-bottom: 1px solid var(--border);
    }
    .pd-breadcrumb a { color: var(--text-muted); }
    .pd-breadcrumb a:hover { color: var(--gold); }
    .pd-breadcrumb span { color: var(--text); }

    .pd-main {
        display: grid;
        grid-template-columns: 55% 45%;
        min-height: 85vh;
    }
    @@media (max-width: 992px) { .pd-main { grid-template-columns: 1fr; } }

    /* Gallery */
    .pd-gallery {
        background: #0d0d0d;
        position: sticky;
        top: 78px;
        height: calc(100vh - 78px);
        display: flex;
        flex-direction: column;
        padding: 20px;
        gap: 12px;
        z-index: 1;
    }
    @@media (max-width: 992px) {
        .pd-gallery { position: relative; top: unset; height: 70vw; max-height: 500px; }
    }

    .swiper-main {
        width: 65%;
        margin: 0 auto;
        aspect-ratio: 4/5;
        border-radius: 2px;
        overflow: hidden;
    }
    .swiper-main .swiper-slide {
        display: flex; justify-content: center; align-items: center;
        background: #0d0d0d; height: 100%; width: 100%;
    }
    .swiper-main img {
        width: 100%; height: 100%; object-fit: contain;
        transition: transform 0.6s ease;
    }
    .swiper-main .swiper-slide:hover img { transform: scale(1.04); }

    .swiper-thumbs .swiper-slide {
        width: 70px !important; height: 70px !important;
        border: 2px solid transparent; cursor: pointer; border-radius: 2px;
        overflow: hidden; opacity: 0.55; transition: all 0.3s;
    }
    .swiper-thumbs .swiper-slide img { width: 100%; height: 100%; object-fit: cover; }
    .swiper-thumbs .swiper-slide-thumb-active { border-color: var(--gold); opacity: 1; }

    .badge-new {
        position: absolute; top: 20px; left: 20px;
        background: var(--gold); color: var(--black);
        font-size: 0.65rem; font-weight: 700; letter-spacing: 2px;
        padding: 5px 12px; z-index: 5;
    }

    /* Info Panel */
    .pd-info {
        padding: 50px 45px;
        overflow-y: auto;
        display: flex; flex-direction: column;
        position: relative; z-index: 2;
    }
    @@media (max-width: 768px) { .pd-info { padding: 30px 20px; } }

    .pd-brand {
        font-size: 0.72rem; letter-spacing: 3px; color: var(--gold);
        text-transform: uppercase; margin-bottom: 10px;
    }
    .pd-title {
        font-family: var(--font-display);
        font-size: 2.2rem; font-weight: 500; line-height: 1.2;
        color: var(--text); margin-bottom: 18px; text-transform: uppercase;
    }

    .stars-row { display: flex; align-items: center; gap: 10px; margin-bottom: 22px; }
    .stars { color: var(--gold); font-size: 0.9rem; letter-spacing: 2px; }
    .stars-count { font-size: 0.78rem; color: var(--text-muted); }
    .stars-link { font-size: 0.78rem; color: var(--gold); text-decoration: underline; cursor: pointer; }

    .pd-divider { border: none; border-top: 1px solid var(--border); margin: 20px 0; }

    .pd-price { font-size: 2rem; font-weight: 700; color: var(--text); letter-spacing: 1px; margin-bottom: 6px; }
    .pd-price-subtag { font-size: 0.78rem; color: var(--text-muted); margin-bottom: 24px; }

    .stock-badge {
        display: inline-flex; align-items: center; gap: 6px;
        font-size: 0.75rem; letter-spacing: 1px; padding: 5px 12px;
        border-radius: 2px; margin-bottom: 24px; font-weight: 600;
    }
    .stock-badge.ok { background: rgba(34,197,94,0.1); color: #4ade80; border: 1px solid rgba(74,222,128,0.3); }
    .stock-badge.low { background: rgba(234,179,8,0.1); color: #eab308; border: 1px solid rgba(234,179,8,0.3); }
    .stock-badge.out { background: rgba(239,68,68,0.1); color: #f87171; border: 1px solid rgba(239,68,68,0.3); }

    .pd-desc { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.8; margin-bottom: 28px; }

    .trust-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 28px; }
    .trust-item {
        display: flex; align-items: center; gap: 8px;
        padding: 10px 14px; background: var(--black-card);
        border: 1px solid var(--border); font-size: 0.78rem; color: var(--text-secondary);
    }
    .trust-item i { color: var(--gold); }

    .size-label {
        font-size: 0.75rem; letter-spacing: 2px; color: var(--text-muted);
        text-transform: uppercase; margin-bottom: 10px;
    }
    .size-options { display: flex; gap: 8px; margin-bottom: 24px; flex-wrap: wrap; position: relative; z-index: 10; }
    .size-box {
        width: 46px; height: 46px; border: 1px solid var(--border-light);
        display: flex; justify-content: center; align-items: center;
        cursor: pointer; font-size: 0.8rem; letter-spacing: 1px; color: var(--text-muted);
        transition: all 0.2s;
    }
    .size-box:hover { border-color: var(--gold); color: var(--gold); }
    .size-box.active { border-color: var(--gold); background: var(--gold); color: var(--black); font-weight: 700; }
    .size-box.disabled { border-color: var(--border); color: #2a2a2a; cursor: not-allowed; position: relative; }
    .size-box.disabled::after {
        content: ''; position: absolute; width: 60%; height: 1px;
        background: #2a2a2a; transform: rotate(-45deg);
    }

    .qty-row { display: flex; align-items: center; gap: 16px; margin-bottom: 28px; }
    .qty-controls { display: inline-flex; border: 1px solid var(--border-light); overflow: hidden; }
    .qty-btn {
        background: transparent; border: none;
        width: 42px; height: 42px; color: var(--text); font-size: 1.2rem;
        cursor: pointer; transition: background 0.2s;
    }
    .qty-btn:hover { background: var(--border); }
    .qty-input {
        width: 52px; text-align: center; background: var(--black-card);
        border: none; color: var(--text); font-weight: 700; font-size: 0.95rem;
        border-left: 1px solid var(--border-light); border-right: 1px solid var(--border-light);
    }
    .qty-total { font-size: 0.85rem; color: var(--text-muted); }
    .qty-total strong { color: var(--gold); }

    .btn-cta-main {
        width: 100%; padding: 16px; background: var(--gold); color: var(--black);
        border: none; font-size: 0.85rem; font-weight: 700; letter-spacing: 3px;
        text-transform: uppercase; cursor: pointer; transition: all 0.3s;
        margin-bottom: 12px; position: relative; overflow: hidden;
    }
    .btn-cta-main:hover { background: var(--gold-light); transform: translateY(-1px); }
    .btn-cta-main:active { transform: translateY(0); }
    .btn-cta-main:disabled { opacity: 0.4; cursor: not-allowed; }
    .btn-cta-sub {
        width: 100%; padding: 14px; background: transparent; color: var(--text);
        border: 1px solid var(--border-light); font-size: 0.8rem; font-weight: 600;
        letter-spacing: 2px; text-transform: uppercase; cursor: pointer;
        transition: all 0.3s; text-decoration: none; display: block; text-align: center;
    }
    .btn-cta-sub:hover { border-color: var(--gold); color: var(--gold); }

    /* Reviews */
    .rec-section { margin-top: 40px; }
    .rec-title {
        font-size: 0.7rem; letter-spacing: 3px; color: var(--text-muted);
        text-transform: uppercase; margin-bottom: 18px;
    }
    .rec-list { display: flex; flex-direction: column; gap: 14px; }
    .rec-item {
        display: flex; align-items: flex-start; gap: 14px;
        padding: 16px; background: var(--black-card);
        border: 1px solid var(--border); transition: border-color 0.3s;
    }
    .rec-item:hover { border-color: var(--border-light); }
    .rec-content { flex: 1; }
    .rec-handle { font-size: 0.8rem; color: var(--gold); font-weight: 600; margin-bottom: 3px; }
    .rec-text { font-size: 0.78rem; color: var(--text-secondary); line-height: 1.5; }
    .rec-stars { color: var(--gold); font-size: 0.65rem; margin-bottom: 4px; }

    .review-form {
        background: var(--black-card); border: 1px solid var(--border);
        padding: 20px; margin-bottom: 18px;
    }
    .review-form label {
        font-size: 0.75rem; letter-spacing: 2px; color: var(--text-muted);
        text-transform: uppercase; margin-bottom: 12px; display: block;
    }
    .review-form input, .review-form textarea {
        width: 100%; padding: 10px 12px; background: var(--black-soft);
        border: 1px solid var(--border); color: var(--text); font-size: 0.82rem;
        margin-bottom: 8px; outline: none;
    }
    .review-form input:focus, .review-form textarea:focus { border-color: var(--gold); }
    .review-form textarea { resize: vertical; }
    .btn-review-submit {
        margin-top: 10px; width: 100%; padding: 12px;
        background: var(--gold); color: var(--black); border: none;
        font-size: 0.78rem; font-weight: 700; letter-spacing: 2px;
        text-transform: uppercase; cursor: pointer;
    }
    .btn-review-submit:hover { background: var(--gold-light); }
</style>

<div style="background: var(--black); min-height: calc(100vh - 78px); color: var(--text);">
    <!-- Breadcrumb -->
    <nav class="pd-breadcrumb" data-reveal="up">
        <a href="/">INICIO</a> &nbsp;/&nbsp;
        <a href="/Shop/Category/@(Model?.Seccion ?? "Hombre")">@(Model?.Seccion?.ToUpper() ?? "COLECCIÓN")</a> &nbsp;/&nbsp;
        <span>@prodName.ToUpper()</span>
    </nav>

    <!-- Main Grid -->
    <div class="pd-main">
        <!-- LEFT: Gallery -->
        <div class="pd-gallery" data-reveal="left">
            <span class="badge-new">NUEVO</span>
            <div class="swiper swiper-main mySwiper2">
                <div class="swiper-wrapper">
                    @foreach (var url in allImages)
                    {
                        <div class="swiper-slide">
                            <img src="@url" alt="@prodName" loading="lazy" />
                        </div>
                    }
                </div>
                <div class="swiper-button-next" style="color: var(--gold);"></div>
                <div class="swiper-button-prev" style="color: var(--gold);"></div>
            </div>
            @if (allImages.Count > 1)
            {
                <div class="swiper swiper-thumbs mySwiper" style="height: 76px;">
                    <div class="swiper-wrapper">
                        @foreach (var url in allImages)
                        {
                            <div class="swiper-slide"><img src="@url" alt="thumb" /></div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- RIGHT: Info Panel -->
        <div class="pd-info">
            <div data-reveal="up" data-reveal-delay="0.1">
                <div class="pd-brand">@prodBrand</div>
                <h1 class="pd-title">@prodName</h1>
                <div class="stars-row">
                    <div class="stars" id="pdStars">★★★★★</div>
                    <span class="stars-count" id="pdAvg">-- / 5</span>
                    <a class="stars-link" href="#reviewsSection" id="pdCount">(cargando...)</a>
                </div>
            </div>

            <hr class="pd-divider" />

            <div data-reveal="up" data-reveal-delay="0.2">
                <div class="pd-price">$@(string.Format("{0:N0}", prodPrice))</div>
                <div class="pd-price-subtag">IVA incluido · Envío gratis a todo el país</div>
            </div>

            @if (prodStock > 10)
            {
                <span class="stock-badge ok"><i class="fas fa-circle" style="font-size:7px;"></i> EN STOCK</span>
            }
            else if (prodStock > 0)
            {
                <span class="stock-badge low"><i class="fas fa-exclamation-triangle" style="font-size:9px;"></i> ÚLTIMAS @prodStock UNIDADES</span>
            }
            else
            {
                <span class="stock-badge out"><i class="fas fa-times-circle" style="font-size:9px;"></i> AGOTADO</span>
            }

            <hr class="pd-divider" />

            <div data-reveal="up" data-reveal-delay="0.3">
                <p class="pd-desc">@prodDesc</p>

                <div class="trust-grid">
                    <div class="trust-item"><i class="fas fa-shipping-fast"></i> Envío en 24-48h</div>
                    <div class="trust-item"><i class="fas fa-lock"></i> Pago 100% Seguro</div>
                    <div class="trust-item"><i class="fas fa-undo-alt"></i> Devolución 30 Días</div>
                    <div class="trust-item"><i class="fas fa-gem"></i> Garantía Luxury</div>
                </div>
            </div>

            <hr class="pd-divider" />

            <div data-reveal="up" data-reveal-delay="0.4">
                <div class="size-label">TALLA: <strong id="selectedSizeText" style="color:var(--text);">S</strong></div>
                <div class="size-options">
                    <div class="size-box disabled">XS</div>
                    <div class="size-box active" onclick="selectSize(this,'S')">S</div>
                    <div class="size-box" onclick="selectSize(this,'M')">M</div>
                    <div class="size-box" onclick="selectSize(this,'L')">L</div>
                    <div class="size-box" onclick="selectSize(this,'XL')">XL</div>
                    <div class="size-box disabled">XXL</div>
                </div>

                <div class="qty-row">
                    <div class="qty-controls">
                        <button class="qty-btn" onclick="updateQty(-1)">−</button>
                        <input type="text" id="qtyInput" class="qty-input" value="1" readonly />
                        <button class="qty-btn" onclick="updateQty(1)">+</button>
                    </div>
                    <div class="qty-total">
                        Total: <strong id="totalPriceDisplay">$@(string.Format("{0:N0}", prodPrice))</strong>
                    </div>
                </div>

                <form asp-controller="Cart" asp-action="Add" method="post" id="addToCartForm">
                    <input type="hidden" name="productId" value="@Model?.IdProducto" />
                    <input type="hidden" name="quantity" id="hiddenQty" value="1" />
                    <input type="hidden" name="size" id="hiddenSize" value="S" />
                    @if (prodStock == 0)
                    {
                        <button type="button" class="btn-cta-main" disabled>PRODUCTO AGOTADO</button>
                    }
                    else
                    {
                        <button type="submit" class="btn-cta-main" id="addCartBtn">
                            <i class="fas fa-shopping-bag me-2"></i> AGREGAR AL CARRITO
                        </button>
                    }
                </form>
                <a href="/Checkout" class="btn-cta-sub mt-2">
                    <i class="fas fa-bolt me-1"></i> COMPRAR AHORA
                </a>
            </div>

            <!-- Reviews -->
            <div class="rec-section" id="reviewsSection" data-reveal="up" data-reveal-delay="0.5">
                <div class="rec-title">✦ &nbsp;OPINIONES DE CLIENTES</div>

                <div class="review-form">
                    <label>DEJA TU RESEÑA</label>
                    <div id="starPicker" style="display:flex;gap:6px;margin-bottom:12px;cursor:pointer;font-size:1.8rem;">
                        <span class="sp" data-v="1" style="color:var(--border);transition:color 0.2s,transform 0.2s;display:inline-block;">★</span>
                        <span class="sp" data-v="2" style="color:var(--border);transition:color 0.2s,transform 0.2s;display:inline-block;">★</span>
                        <span class="sp" data-v="3" style="color:var(--border);transition:color 0.2s,transform 0.2s;display:inline-block;">★</span>
                        <span class="sp" data-v="4" style="color:var(--border);transition:color 0.2s,transform 0.2s;display:inline-block;">★</span>
                        <span class="sp" data-v="5" style="color:var(--border);transition:color 0.2s,transform 0.2s;display:inline-block;">★</span>
                    </div>
                    <input type="text" id="reviewName" placeholder="Tu nombre (opcional)" />
                    <textarea id="reviewText" rows="3" placeholder="Escribe tu opinión sobre este producto..."></textarea>
                    <button onclick="submitReview()" class="btn-review-submit">PUBLICAR RESEÑA</button>
                    <div id="reviewMsg" style="margin-top:8px;font-size:0.78rem;color:var(--gold);display:none;"></div>
                </div>

                <div class="rec-list" id="reviewsList">
                    <div class="skeleton-item">
                        <div class="skeleton-avatar"></div>
                        <div class="skeleton-content">
                            <div class="skeleton-line short"></div>
                            <div class="skeleton-line long"></div>
                            <div class="skeleton-line medium"></div>
                        </div>
                    </div>
                    <div class="skeleton-item" style="border:none;">
                        <div class="skeleton-avatar"></div>
                        <div class="skeleton-content">
                            <div class="skeleton-line short"></div>
                            <div class="skeleton-line medium"></div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Toast -->
<div class="toast-luxury" id="cartToast">
    <i class="fas fa-check-circle" style="color:var(--gold);margin-right:10px;"></i>
    <div>
        <strong style="font-size:0.88rem;">¡Añadido al Carrito!</strong>
        <span id="toastProductName" style="font-size:0.82rem;">@prodName</span> fue agregado exitosamente.
    </div>
</div>

@section Scripts {
<script>
    const basePrice = @Convert.ToInt32(prodPrice);

    /* ─── Swiper Init ─── */
    var thumbSwiper = null;
    if (document.querySelector(".mySwiper")) {
        thumbSwiper = new Swiper(".mySwiper", {
            spaceBetween: 8, slidesPerView: "auto",
            freeMode: true, watchSlidesProgress: true, direction: 'horizontal'
        });
    }

    var mainSwiperConfig = {
        spaceBetween: 10,
        navigation: { nextEl: ".swiper-button-next", prevEl: ".swiper-button-prev" }
    };
    if (document.querySelectorAll('.mySwiper2 .swiper-slide').length > 1) {
        mainSwiperConfig.autoplay = { delay: 5000, disableOnInteraction: false };
        mainSwiperConfig.loop = true;
    }
    if (thumbSwiper) { mainSwiperConfig.thumbs = { swiper: thumbSwiper }; }
    var mainSwiper = new Swiper(".mySwiper2", mainSwiperConfig);

    /* ─── Size Selector ─── */
    function selectSize(el, size) {
        if (el.classList.contains('disabled')) return;
        document.querySelectorAll('.size-box').forEach(b => b.classList.remove('active'));
        el.classList.add('active');
        document.getElementById('selectedSizeText').innerText = size;
        document.getElementById('hiddenSize').value = size;
    }

    /* ─── Quantity ─── */
    function updateQty(change) {
        const input = document.getElementById('qtyInput');
        const maxStock = @prodStock;
        let val = parseInt(input.value) + change;
        if (val < 1) val = 1;
        if (val > maxStock && maxStock > 0) val = maxStock;
        input.value = val;
        document.getElementById('hiddenQty').value = val;
        document.getElementById('totalPriceDisplay').innerText =
            '$' + (basePrice * val).toLocaleString('es-CO', { minimumFractionDigits: 0 });
    }

    /* ─── Toast ─── */
    document.getElementById('addToCartForm')?.addEventListener('submit', function() {
        const toast = document.getElementById('cartToast');
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 3000);
    });

    /* ─── Reviews System ─── */
    const API = 'https://luxuryco.onrender.com/api';
    const PRODUCT_ID = @(Model?.IdProducto ?? 0);

    (function() {
        var picked = 0;
        var stars = document.querySelectorAll('#starPicker .sp');

        function paint(upTo, lock) {
            stars.forEach(function(s) {
                var v = parseInt(s.getAttribute('data-v'));
                s.style.color     = v <= upTo ? '#d4af37' : (lock ? '#444' : 'var(--border)');
                s.style.transform = v <= upTo && lock ? 'scale(1.15)' : 'scale(1)';
            });
        }

        stars.forEach(function(star) {
            star.addEventListener('mouseenter', function() {
                paint(parseInt(this.getAttribute('data-v')), false);
            });
            star.addEventListener('click', function() {
                picked = parseInt(this.getAttribute('data-v'));
                window._starRating = picked;
                paint(picked, true);
                var lbl = document.getElementById('starLabel');
                if (!lbl) {
                    lbl = document.createElement('div');
                    lbl.id = 'starLabel';
                    lbl.style.cssText = 'font-size:0.72rem;color:var(--gold);letter-spacing:1px;margin-top:6px;';
                    document.getElementById('starPicker').insertAdjacentElement('afterend', lbl);
                }
                var labels = ['','Malo','Regular','Bueno','Muy bueno','Excelente'];
                lbl.textContent = labels[picked] + '  (' + picked + '/5)';
            });
        });

        document.getElementById('starPicker')?.addEventListener('mouseleave', function() {
            paint(picked, picked > 0);
        });
    })();

    async function loadReviews() {
        try {
            const res = await fetch(API + '/resena/producto/' + PRODUCT_ID);
            const data = await res.json();
            const avg = data.promedio || 0;
            const total = data.total || 0;
            document.getElementById('pdAvg').textContent = avg + ' / 5';
            document.getElementById('pdCount').textContent = '(' + total + ' valoraciones)';
            const full = Math.floor(avg);
            const half = avg - full >= 0.5 ? 1 : 0;
            const empty = 5 - full - half;
            document.getElementById('pdStars').textContent = '★'.repeat(full) + (half ? '★' : '') + '☆'.repeat(empty);

            const list = document.getElementById('reviewsList');
            if (!data.resenas || data.resenas.length === 0) {
                list.innerHTML = '<div style="text-align:center;padding:30px;color:var(--text-muted);font-size:0.82rem;">Sé el primero en dejar una reseña ✦</div>';
                return;
            }
            list.innerHTML = data.resenas.map(r => `
                <div class="rec-item">
                    <div style="width:44px;height:44px;border-radius:50%;background:var(--gold);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--black);font-size:1rem;flex-shrink:0;">
                        ${r.nombreUsuario.charAt(0).toUpperCase()}
                    </div>
                    <div class="rec-content">
                        <div class="rec-stars">${'★'.repeat(r.calificacion)}${'☆'.repeat(5-r.calificacion)}</div>
                        <div class="rec-handle">${r.nombreUsuario}</div>
                        <div class="rec-text">${r.comentario}</div>
                        <div style="font-size:0.68rem;color:var(--text-muted);margin-top:4px;">${r.fecha}</div>
                    </div>
                </div>
            `).join('');
        } catch(e) {
            document.getElementById('reviewsList').innerHTML = '<div style="text-align:center;padding:20px;color:var(--text-muted);font-size:0.8rem;">No se pudieron cargar las reseñas.</div>';
        }
    }

    async function submitReview() {
        const comment = document.getElementById('reviewText').value.trim();
        const msgEl   = document.getElementById('reviewMsg');
        const rating  = window._starRating || 0;

        if (rating === 0) {
            msgEl.style.display = 'block'; msgEl.style.color = 'var(--danger)';
            msgEl.textContent = 'Selecciona una calificación (1-5 estrellas)'; return;
        }
        if (!comment) {
            msgEl.style.display = 'block'; msgEl.style.color = 'var(--danger)';
            msgEl.textContent = 'Escribe un comentario antes de publicar'; return;
        }

        msgEl.style.display = 'block'; msgEl.style.color = 'var(--text-muted)';
        msgEl.textContent = 'Publicando...';

        try {
            const res = await fetch(API + '/resena', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    idProducto: PRODUCT_ID, idUsuario: 0,
                    calificacion: rating, comentario: comment,
                    nombreInvitado: document.getElementById('reviewName').value.trim() || 'Anónimo'
                })
            });
            if (res.ok) {
                msgEl.style.color = 'var(--gold)';
                msgEl.textContent = '¡Reseña publicada! Gracias ✦';
                document.getElementById('reviewText').value = '';
                document.getElementById('reviewName').value = '';
                window._starRating = 0;
                document.querySelectorAll('#starPicker .sp').forEach(function(s) {
                    s.style.color = 'var(--border)'; s.style.transform = 'scale(1)';
                });
                var lbl = document.getElementById('starLabel');
                if (lbl) lbl.textContent = '';
                loadReviews();
            } else {
                const data = await res.json().catch(function() { return {}; });
                msgEl.style.color = 'var(--danger)';
                msgEl.textContent = data.message || 'Error al publicar. Intenta de nuevo.';
            }
        } catch(e) {
            msgEl.style.color = 'var(--danger)';
            msgEl.textContent = 'Error de conexión con el servidor.';
        }
    }

    loadReviews();
</script>
}
